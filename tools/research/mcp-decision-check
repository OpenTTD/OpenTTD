#!/usr/bin/env bash
# RESEARCH-ONLY. Prismatic decides the bot over the bridge's decision contract, end to end (I0041).
#
# Runs `mcp-e2e --no-gui --no-browser` against an isolated instance registry, waits for the bot,
# then checks the panel's two halves of research/prismatic-bridge/decision-contract.schema.json:
#
#   1. GET /api/bridge/companies answers the bridge's CompanyOut for every company, the bot among them;
#   2. POST /api/decision/pull with no URL is refused (501), and a directive outside the contract is
#      refused (422) with nothing applied;
#   3. a directive in the shape prismatic_api's OpenttdController#decision answers (company_id of the
#      bot, settings "aggressiveness=N", its own working alongside) is applied: the answer is a
#      DecisionPullResult, the setting goes through approval, and the running bot reads N.
#
# and, since I0085, how recorded history reaches Prismatic and how its fit comes back:
#
#   1b. every company of GET /api/bridge/companies offers its `history` (prismatic-history/v1): the
#       bus endpoint and a samples query, which the panel's /api/db/query answers with its columns;
#   3b. the stand-in's directive carries a `fit` (prismatic-fit/v1) from that query with the rows it
#       answered, and the plan.directive the store holds (read back through /api/db/query) names that
#       query, those rows and the fit as inputs.stored; with Prismatic itself, a directive without a
#       fit is recorded with its stated fallback instead;
#   2b. the directive outside the contract carries no fit, and its plan.directive says so;
#   2c. (research/agent-loop.md step 1) the stand-in reads GET /api/bridge/companies while it decides,
#       as Prismatic does, and echoes the observation's digest; a directive decided without observing,
#       or naming an observation it was not served, is refused (409) with nothing applied, and the
#       applied directive's plan.directive names its observation (3c).
#
# The run's store is its own ($TMP/store), never the user's.
#
# The directive comes from PRISMATIC_DECISION_URL when it is set (Prismatic itself, e.g.
# http://127.0.0.1:4000/api/openttd/decision, started with OPENTTD_BRIDGE_URL=<panel>/api/bridge;
# the check prints the panel URL and waits for it), else from a stand-in on a loopback port that
# answers what OpenttdController#decision answers, with the value chosen here. Prismatic reads its
# bridge URL once, at start, so give the panel a known port with --panel-port and start Prismatic
# with OPENTTD_BRIDGE_URL=http://127.0.0.1:<that port>/api/bridge first.
#
# Usage: tools/research/mcp-decision-check [--bin PATH] [--panel-port N] [--no-plan-bot]
#        exit 0 PASS, 1 FAIL, 2 usage, 3 no binary
# --no-plan-bot starts the bot without the planner first, so it runs within seconds: the decision
# path does not need a plan, and on a loaded machine the planned start can outlast the 10-minute wait.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
BIN="$ROOT_DIR/build-gate-research/openttd"
PANEL_PORT=""
PLAN=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --bin) BIN="$2"; shift 2 ;;
    --panel-port) PANEL_PORT="$2"; shift 2 ;;
    --no-plan-bot) PLAN=(--no-plan-bot); shift ;;
    -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "mcp-decision-check: unknown option $1" >&2; exit 2 ;;
  esac
done
# A linked worktree usually has no build of its own: take the primary checkout's.
if [[ ! -x "$BIN" ]]; then
  PRIMARY="$(cd "$(git -C "$ROOT_DIR" rev-parse --git-common-dir)/.." && pwd)"
  [[ -x "$PRIMARY/build-gate-research/openttd" ]] && BIN="$PRIMARY/build-gate-research/openttd"
fi
[[ -x "$BIN" ]] || { echo "mcp-decision-check: no game binary at $BIN (run tools/gate.sh research, or pass --bin)" >&2; exit 3; }
echo "==> game binary $BIN"

TMP="$(mktemp -d "${TMPDIR:-/tmp}/mcp-decision-check.XXXXXX")"
export PRISMATIC_MCP_REGISTRY="$TMP/registry"
export PRISMATIC_STORE_DIR="$TMP/store"
mkdir -p "$PRISMATIC_MCP_REGISTRY" "$PRISMATIC_STORE_DIR"
free_port() { python3 -I -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'; }
PIDS=()
cleanup() {
  for p in "${PIDS[@]}"; do kill -TERM "$p" 2>/dev/null || true; done
  wait 2>/dev/null || true
  rm -rf "$TMP"
}
trap cleanup EXIT INT TERM

FAILS=0
pass() { echo "PASS $*"; }
fail() { echo "FAIL $*"; FAILS=$((FAILS + 1)); }

[[ -n "$PANEL_PORT" ]] || PANEL_PORT="$(free_port)"
URL="http://127.0.0.1:$PANEL_PORT"
"$ROOT_DIR/tools/research/mcp-e2e" --bin "$BIN" --no-gui --no-browser "${PLAN[@]}" --panel-port "$PANEL_PORT" --seed 31337 \
  > "$TMP/e2e.log" 2>&1 &
PIDS+=($!)
echo "==> mcp-e2e (log $TMP/e2e.log), panel $URL"
for ((i = 0; i < 300; i++)); do
  curl -s -m 3 "$URL/api/status" 2>/dev/null | grep -q '"ai_started": true' && break
  sleep 2
done
curl -s -m 3 "$URL/api/status" | grep -q '"ai_started": true' || { echo "mcp-decision-check: no bot"; tail -30 "$TMP/e2e.log"; exit 1; }

# 1. The bridge's companies, the bot among them (a started AI takes a moment to found its company).
BOT=""
for ((i = 0; i < 60; i++)); do
  curl -s -m 10 "$URL/api/bridge/companies" > "$TMP/companies.json" || true
  BOT="$(jq -r '[.[]? | select(.is_ai == true)][0].id // empty' "$TMP/companies.json" 2>/dev/null)"
  [[ -n "$BOT" ]] && break
  sleep 2
done
fields='["id","name","manager","is_ai","money","loan","income","company_value","performance","trains","lorries","busses","planes","ships"]'
missing="$(jq -c --argjson f "$fields" '[.[] | . as $c | $f[] | . as $k | select(($c | has($k)) | not)] | unique' "$TMP/companies.json" 2>/dev/null || echo '"unreadable"')"
[[ -n "$BOT" && "$missing" == "[]" ]] \
  && pass "GET /api/bridge/companies answers CompanyOut for $(jq length "$TMP/companies.json") companies; the bot is company $BOT" \
  || fail "GET /api/bridge/companies: bot '$BOT', missing fields $missing: $(head -c 400 "$TMP/companies.json")"

# One read-only statement on the panel's store: the answer of POST /api/db/query.
db_query() { jq -n --arg sql "$1" '{sql: $sql}' | curl -s -m 20 -X POST -H 'Content-Type: application/json' -d @- "$URL/api/db/query"; }
# The data of the newest plan.directive in the store (committed within a second), newer than seq $1.
last_directive() {
  local after="$1" out
  for ((j = 0; j < 20; j++)); do
    out="$(db_query "SELECT seq, data FROM events WHERE kind = 'plan.directive' AND seq > $after ORDER BY seq DESC LIMIT 1")"
    [[ "$(jq -r '.count // 0' <<< "$out")" -gt 0 ]] && { jq -c '.rows[0][1] | if type == "string" then fromjson else . end' <<< "$out"; return; }
    sleep 0.5
  done
  echo null
}
directive_seq() { db_query "SELECT coalesce(max(seq), 0) FROM events WHERE kind = 'plan.directive'" | jq -r '.rows[0][0] // 0'; }

# 1b. The history each company offers, and the bot's samples query answered by the store.
bad_history="$(jq -c '[.[] | select((.history.schema != "prismatic-history/v1") or ((.history.bus.endpoint // "") | startswith("tcp://") | not)
                                 or ((.history.samples_query // "") == "") or ((.history.query_url // "") | endswith("/api/db/query") | not)) | .id]' "$TMP/companies.json" 2>/dev/null || echo '"unreadable"')"
SQL="$(jq -r --argjson c "${BOT:-0}" '.[] | select(.id == $c) | .history.samples_query // empty' "$TMP/companies.json")"
COLS="$(jq -c --argjson c "${BOT:-0}" '.[] | select(.id == $c) | .history.columns' "$TMP/companies.json")"
ROWS=0
for ((i = 0; i < 30; i++)); do
  db_query "$SQL" > "$TMP/samples.json"
  ROWS="$(jq -r '.count // 0' "$TMP/samples.json" 2>/dev/null || echo 0)"
  [[ "$ROWS" -gt 0 ]] && break
  sleep 2
done
[[ "$bad_history" == "[]" && -n "$SQL" && "$(jq -c .columns "$TMP/samples.json")" == "$COLS" && "$ROWS" -gt 0 ]] \
  && pass "every company offers its history (bus $(jq -r '.[0].history.bus.endpoint' "$TMP/companies.json"), samples query); the bot's query answers $ROWS rows of $(jq -r '.columns | length' "$TMP/samples.json") columns" \
  || fail "history: companies without a valid one $bad_history, the bot's query answered $(head -c 300 "$TMP/samples.json")"

# 2. Refusals: no URL, and a directive outside the contract.
code="$(curl -s -o "$TMP/r501.json" -w '%{http_code}' -X POST -H 'Content-Type: application/json' -d '{}' "$URL/api/decision/pull")"
if [[ -n "${PRISMATIC_DECISION_URL:-}" ]]; then
  echo "     (PRISMATIC_DECISION_URL is set, so the no-URL refusal is not checked)"
else
  [[ "$code" == 501 ]] && pass "a pull with no URL is refused: $(jq -r .error "$TMP/r501.json")" || fail "a pull with no URL answered $code"
fi

# The stand-in Prismatic: answers whatever $TMP/directive.json holds, as prismatic_api would.
STAND_PORT="$(free_port)"
# Like Prismatic, it reads the panel's GET /api/bridge/companies while it decides (so the panel records
# the observation the directive is bound to) and echoes that observation's digest. $TMP/mode makes it
# misbehave on purpose: `blind` decides without observing, `wrong` echoes a digest it was not served.
python3 -I - "$STAND_PORT" "$TMP/directive.json" "$URL" "$TMP/mode" > "$TMP/stand-in.log" 2>&1 <<'PY' &
import http.server, json, sys, urllib.request
port, path, panel, mode_file = int(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        directive = json.load(open(path))
        mode = open(mode_file).read().strip()
        if mode != 'blind' and isinstance(directive, dict) and directive:
            urllib.request.urlopen(panel + '/api/bridge/companies', timeout=30).read()
            seen = json.load(urllib.request.urlopen(panel + '/api/bridge/observation', timeout=30))
            directive['observed_digest'] = '0000000000000000' if mode == 'wrong' else seen['latest']['digest']
        body = json.dumps(directive).encode()
        self.send_response(200); self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body))); self.end_headers(); self.wfile.write(body)
    def log_message(self, *a): pass
http.server.HTTPServer(('127.0.0.1', port), H).serve_forever()
PY
PIDS+=($!)
STAND="http://127.0.0.1:$STAND_PORT/api/openttd/decision"
echo '{}' > "$TMP/directive.json"
echo observe > "$TMP/mode"
for ((i = 0; i < 50; i++)); do curl -s -m 1 -o /dev/null "$STAND" && break; sleep 0.2; done

echo '{"ai": "", "company_id": 15, "settings": "aggressiveness=high"}' > "$TMP/directive.json"
code="$(curl -s -o "$TMP/r422.json" -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
  -d "{\"url\": \"$STAND\"}" "$URL/api/decision/pull")"
[[ "$code" == 422 && "$(jq '.errors | length' "$TMP/r422.json")" == 3 && "$(jq 'has("applied_rcon")' "$TMP/r422.json")" == false ]] \
  && pass "a directive outside the contract is refused with its 3 reasons, nothing applied" \
  || fail "a directive outside the contract answered $code: $(head -c 300 "$TMP/r422.json")"
refused="$(last_directive 0)"
[[ "$(jq -r '.choice.outcome' <<< "$refused")" == refused && "$(jq -r '.inputs.stored.fallback // ""' <<< "$refused")" == "Prismatic sent no fit"* ]] \
  && pass "its plan.directive in the store is refused and states the fallback: $(jq -r '.inputs.stored.fallback' <<< "$refused" | cut -c1-60)..." \
  || fail "the refused directive's plan.directive: $(head -c 300 <<< "$refused")"

# 3. A decision applied to the running bot.
setting() { curl -s -m 10 "$URL/api/bots" | jq -r --argjson c "$BOT" \
  '[.running[] | select(.id == $c) | .settings[] | select(.name == "aggressiveness") | (.value // .current)][0] // empty'; }
BEFORE="$(setting)"
WANT=$(( BEFORE == 100 ? 25 : 100 ))
if [[ -n "${PRISMATIC_DECISION_URL:-}" ]]; then
  SRC="$PRISMATIC_DECISION_URL"
  echo "==> the directive comes from Prismatic at $SRC (its OPENTTD_BRIDGE_URL must be $URL/api/bridge)"
else
  SRC="$STAND"
  # What a fitting Prismatic answers: its working names the samples query it was fitted from.
  jq -n --argjson c "$BOT" --arg s "aggressiveness=$WANT" --argjson w "$WANT" --arg q "$SQL" --argjson n "$ROWS" \
        --arg u "$URL/api/db/query" \
    '{ai: "PrismaticAI", company_id: $c, settings: $s, engine: "PrismaticMonteCarlo.simulate/3", chosen_aggressiveness: $w, candidates: [],
      fit: {schema: "prismatic-fit/v1", model: "growth_by_aggressiveness",
            parameters: {by_aggressiveness: [{aggressiveness: $w, mean_growth: 0.04, std_growth: 0.1, n: $n}]},
            samples: {query: $q, query_url: $u, rows: $n, runs: 1}, quality: {rows_used: $n}}}' \
    > "$TMP/directive.json"
fi
# 2c. A directive not bound to what Prismatic observed is refused before any step (research/agent-loop.md
#     step 1): decided without observing during the pull, or naming an observation it was not served.
if [[ -z "${PRISMATIC_DECISION_URL:-}" ]]; then
  for mode in blind wrong; do
    echo "$mode" > "$TMP/mode"
    code="$(curl -s -o "$TMP/r409.json" -w '%{http_code}' -m 60 -X POST -H 'Content-Type: application/json' \
      -d "{\"url\": \"$STAND\"}" "$URL/api/decision/pull")"
    want="$([[ $mode == blind ]] && echo 'without observing' || echo 'names observation')"
    [[ "$code" == 409 && "$(jq -r '.errors | join(" ")' "$TMP/r409.json")" == *"$want"* && "$(jq 'has("applied_rcon")' "$TMP/r409.json")" == false ]] \
      && pass "a directive $([[ $mode == blind ]] && echo 'decided without observing' || echo 'bound to another observation') is refused (409), nothing applied" \
      || fail "the $mode directive answered $code: $(head -c 300 "$TMP/r409.json")"
  done
  # The store commits in batches: wait until both refusals are in it, then read them.
  STALE=0
  for ((i = 0; i < 20; i++)); do
    STALE="$(db_query "SELECT count(*) FROM events WHERE kind = 'plan.directive' AND json_extract_string(data, '\$.choice.outcome') = 'stale'" | jq -r '.rows[0][0] // 0')"
    [[ "$STALE" -ge 2 ]] && break
    sleep 0.5
  done
  [[ "$STALE" -ge 2 ]] \
    && pass "both refusals are in the store as plan.directive with outcome stale" \
    || fail "the store holds $STALE stale plan.directive events, expected 2"
  echo observe > "$TMP/mode"
fi
SEQ0="$(directive_seq)"
curl -s -m 10 -X POST -H 'Content-Type: application/json' -d '{"on": true}' "$URL/api/auto-approve" > /dev/null
curl -s -m 90 -X POST -H 'Content-Type: application/json' -d "{\"url\": \"$SRC\"}" "$URL/api/decision/pull" > "$TMP/pull.json"
shape="$(jq -r '(has("called_url") and has("raw_response") and (.applied_rcon.lines | type == "array"))' "$TMP/pull.json" 2>/dev/null || echo false)"
[[ "$shape" == true ]] \
  && pass "the pull answers a DecisionPullResult: $(jq -c '.applied_rcon.lines' "$TMP/pull.json")" \
  || fail "the pull answered $(head -c 400 "$TMP/pull.json")"
[[ -n "${PRISMATIC_DECISION_URL:-}" ]] && WANT="$(jq -r '.raw_response.settings' "$TMP/pull.json" | sed -n 's/.*aggressiveness=\([0-9]*\).*/\1/p')"
AFTER=""
for ((i = 0; i < 30; i++)); do AFTER="$(setting)"; [[ "$AFTER" == "$WANT" ]] && break; sleep 1; done
[[ "$AFTER" == "$WANT" ]] \
  && pass "the running bot reads aggressiveness=$AFTER (was $BEFORE), as decided" \
  || fail "the bot reads aggressiveness=$AFTER (was $BEFORE), decided $WANT"
curl -s -m 10 "$URL/api/events?kinds=panel.ai" | grep -q 'Prismatic decided' \
  && pass "the decision is in the panel's event feed" || fail "no 'Prismatic decided' event"

# 3d. The applied directive waited for approval; its outcome follows from the game's verdict
#     (research/agent-loop.md step 2): plan.directive_outcome names it and says applied.
DSEQ="$(db_query "SELECT seq FROM events WHERE kind = 'plan.directive' AND seq > $SEQ0 ORDER BY seq DESC LIMIT 1" | jq -r '.rows[0][0] // empty')"
OUT=""
for ((i = 0; i < 40; i++)); do
  OUT="$(db_query "SELECT data FROM events WHERE kind = 'plan.directive_outcome' ORDER BY seq DESC LIMIT 1" | jq -c '.rows[0][0] // empty | if type == "string" then fromjson else . end' 2>/dev/null)"
  [[ -n "$OUT" && "$(jq -r '.inputs.live.directive_seq' <<< "$OUT")" == "$DSEQ" ]] && break
  sleep 0.5
done
[[ -n "$OUT" && "$(jq -r '.inputs.live.directive_seq' <<< "$OUT")" == "$DSEQ" && "$(jq -r '.choice.outcome' <<< "$OUT")" == applied \
   && "$(jq -r '.choice.steps[0].verdict' <<< "$OUT")" == VERIFIED_SUCCESS && "$(jq -r '.choice.steps[0].approved_by.channel' <<< "$OUT")" == auto-approve ]] \
  && pass "the directive's outcome follows its approval: plan.directive_outcome for seq $DSEQ says applied (VERIFIED_SUCCESS, decision $(jq -r '.choice.steps[0].decision_id' <<< "$OUT"), approved by $(jq -r '.choice.steps[0].approved_by.channel' <<< "$OUT"))" \
  || fail "no applied plan.directive_outcome for plan.directive $DSEQ: $(head -c 300 <<< "$OUT")"

# 3e. A pull with an idempotency key runs once (research/agent-loop.md step 3): its repeat answers
#     the first result again, replayed, and the store holds no second plan.directive.
if [[ -z "${PRISMATIC_DECISION_URL:-}" ]]; then
  KEY="decision-check-$$"
  jq --arg s "aggressiveness=50" '.settings = $s | .chosen_aggressiveness = 50' "$TMP/directive.json" > "$TMP/d2.json" && cp "$TMP/d2.json" "$TMP/directive.json"
  K1="$(curl -s -m 90 -X POST -H 'Content-Type: application/json' -d "{\"url\": \"$STAND\", \"key\": \"$KEY\"}" "$URL/api/decision/pull")"
  keyed_count() { db_query "SELECT count(*) FROM events WHERE kind = 'plan.directive' AND json_extract_string(data, '\$.inputs.live.key') = '$KEY'" | jq -r '.rows[0][0] // 0'; }
  # The store commits in batches: wait for the first pull's record before repeating.
  for ((i = 0; i < 20; i++)); do [[ "$(keyed_count)" -ge 1 ]] && break; sleep 0.5; done
  K2="$(curl -s -m 90 -X POST -H 'Content-Type: application/json' -d "{\"url\": \"$STAND\", \"key\": \"$KEY\"}" "$URL/api/decision/pull")"
  sleep 2
  KN="$(keyed_count)"
  [[ "$(jq -r '.replayed // false' <<< "$K1")" == false && "$(jq -r '.replayed' <<< "$K2")" == true \
     && "$(jq -c '.applied_rcon.lines' <<< "$K1")" == "$(jq -c '.applied_rcon.lines' <<< "$K2")" && "$KN" == 1 ]] \
    && pass "a keyed pull runs once: its repeat is replayed with the same lines, and the store holds one plan.directive with the key" \
    || fail "keyed pull: first $(head -c 200 <<< "$K1"), repeat $(head -c 200 <<< "$K2"), plan.directive with the key: $KN"
fi

# 3b. What the directive was fitted from, as the store holds its plan.directive.
pd="$(last_directive "$SEQ0")"
echo "$pd" > "$TMP/plan-directive.json"
# 3c. ... and the observation it was decided from (research/agent-loop.md step 1).
[[ "$(jq -r '.inputs.live.observation.digest // ""' <<< "$pd")" =~ ^[0-9a-f]{16}$ && "$(jq -r '.inputs.live.observation.age_ticks' <<< "$pd")" -ge 0 ]] \
  && pass "the applied directive names its observation: digest $(jq -r '.inputs.live.observation.digest' <<< "$pd"), tick $(jq -r '.inputs.live.observation.tick' <<< "$pd"), $(jq -r '.inputs.live.observation.age_ticks' <<< "$pd") ticks old" \
  || fail "the applied directive has no observation: $(jq -c '.inputs.live.observation' <<< "$pd" | head -c 300)"
if [[ -n "${PRISMATIC_DECISION_URL:-}" ]] && ! jq -e '.inputs.live.directive.fit' <<< "$pd" > /dev/null 2>&1; then
  [[ -n "$(jq -r '.inputs.stored.fallback // empty' <<< "$pd")" && "$(jq -r '.choice.accepted' <<< "$pd")" == true ]] \
    && pass "Prismatic sent no fit; its plan.directive states the fallback: $(jq -r '.inputs.stored.fallback' <<< "$pd" | cut -c1-80)..." \
    || fail "Prismatic's plan.directive without a fit: $(head -c 400 <<< "$pd")"
else
  WANT_Q="$(jq -r '.fit.samples.query' "$TMP/directive.json" 2>/dev/null)"
  [[ -n "${PRISMATIC_DECISION_URL:-}" ]] && WANT_Q="$(jq -r '.inputs.live.directive.fit.samples.query // .inputs.live.directive.fit.samples.bus' <<< "$pd")"
  [[ "$(jq -r '.choice.accepted' <<< "$pd")" == true && "$(jq -r '.inputs.stored.query // .inputs.stored.bus' <<< "$pd")" == "$WANT_Q" \
     && "$(jq -c '.inputs.stored.fit' <<< "$pd")" == "$(jq -c '.inputs.live.directive.fit' <<< "$pd")" && "$(jq -r '.inputs.stored.rows' <<< "$pd")" -gt 0 ]] \
    && pass "the store's plan.directive names the fitted samples: query of the bot's history, $(jq -r '.inputs.stored.rows' <<< "$pd") rows, model $(jq -r '.inputs.stored.fit.model' <<< "$pd"), outcome $(jq -r '.choice.outcome' <<< "$pd")" \
    || fail "the store's plan.directive: $(head -c 600 <<< "$pd")"
  jq -r '.applied_rcon.lines[]' "$TMP/pull.json" | grep -q '^fit: .* recorded rows' \
    && pass "the pull's lines say what was recorded: $(jq -r '.applied_rcon.lines[]' "$TMP/pull.json" | grep '^fit: ')" \
    || fail "no fit line in $(jq -c '.applied_rcon.lines' "$TMP/pull.json")"
fi

echo
[[ "$FAILS" == 0 ]] && { echo "mcp-decision-check: PASS"; exit 0; } || { echo "mcp-decision-check: $FAILS failed"; exit 1; }
