#!/usr/bin/env python3
"""RESEARCH-ONLY: regenerate the duel scoreboard in README.md from research/results/duel-*.json.

Writes the region between `<!-- scoreboard:begin -->` and `<!-- scoreboard:end -->`.
`--check` writes nothing and exits 11 when the region would change (Majordomus exit codes).
`--json` writes nothing and prints the scoreboard and whether README.md is current (the panel's
GET /api/scoreboard reads it, so the panel, Swagger and MCP clients see the same numbers).

Usage: tools/research/readme-scoreboard [--check | --json]
With no argument it rewrites the region; any other argument is refused (exit 2) and writes nothing.
"""

import json
import os
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
README = ROOT / "README.md"
RESULTS = ROOT / "research" / "results"
BEGIN, END = "<!-- scoreboard:begin -->", "<!-- scoreboard:end -->"
SEED, MONTHS = 31337, 36
STYLE = ROOT / "tools" / "research" / "noirgfx" / "style.toml"  # NoirGFX palette


def records():
    """The duel records the next commit can hold, counted like tools/surfaces/surfaces.py load_repo.

    What git tracks plus new files it would not ignore, so a rewrite and `--check` agree before and
    after a `git add`; inside a git hook (git exports GIT_INDEX_FILE to pre-commit) only the index,
    because a record written but never added would pass the hook, enter README.md and break CI,
    whose checkout does not have it. Outside a git checkout of ROOT every record on disk counts.
    """
    env = dict(os.environ)
    if env.get("GIT_INDEX_FILE"):  # pre-commit may export it relative to the hook's directory
        env["GIT_INDEX_FILE"] = os.path.abspath(env["GIT_INDEX_FILE"])
    sources = ["--cached"]
    if not env.get("GIT_INDEX_FILE"):
        sources += ["--others", "--exclude-standard"]
    git = lambda *a: subprocess.run(["git", *a], cwd=RESULTS, env=env, check=True,
                                    capture_output=True, text=True).stdout
    try:
        if Path(git("rev-parse", "--show-toplevel").strip()).resolve() != ROOT.resolve():
            raise ValueError("not a checkout of ROOT")
        listed = git("ls-files", "-z", *sources, "--", ".").split("\0")
    except (OSError, ValueError, subprocess.CalledProcessError):
        return sorted(RESULTS.glob("duel-*.json"))
    return sorted(RESULTS / p for p in listed
                  if "/" not in p and Path(p).match("duel-*.json") and (RESULTS / p).exists())


def load():
    runs = []
    for path in records():
        data = json.loads(path.read_text())
        final = data.get("final", {})
        if "1" not in final or "2" not in final:
            continue
        runs.append({
            "path": path,
            "seed": data.get("seed"),
            "months": data.get("months"),
            "label": str(data.get("label", "")),
            "a": int(final["1"]["value"]),
            "b": int(final["2"]["value"]),
            "won": str(data.get("winner", "")).startswith("A"),
            "held": bool(data.get("held_start")),
            "b_rail": int(final["2"].get("trains") or 0) > 0,
        })
    return runs


def mix(runs):
    """What the tally of all records mixes, derived from them: run lengths, held starts, and how
    often the rival ran a train. Every record's own label names its bot revision or setting."""
    months = sorted({r["months"] for r in runs if isinstance(r["months"], int)})
    return {"months_min": months[0] if months else None, "months_max": months[-1] if months else None,
            "held_start": sum(r["held"] for r in runs),
            "rival_without_rail": sum(not r["b_rail"] for r in runs)}


def render(runs):
    style = tomllib.loads(STYLE.read_text())
    signal, grey = style["palette"]["signal"], "#8a8a8a"
    series = [r for r in runs if r["seed"] == SEED and r["months"] == MONTHS]
    best = max(runs, key=lambda r: r["a"])
    wins = sum(r["won"] for r in runs)
    m = mix(runs)
    rel = lambda p: p.relative_to(ROOT).as_posix()
    top = max(r["a"] for r in series)
    lines = [
        BEGIN,
        "<!-- generated by tools/research/readme-scoreboard; edit the results, not this block -->",
        "",
        f"> **Best run: {best['a']:,} vs {best['b']:,}** company value, planned bot vs the same "
        f"bot unplanned, one game, one map (seed {best['seed']}, {best['months']} months) — "
        f"[evidence]({rel(best['path'].with_suffix('.md'))}). "
        f"The planned bot won **{wins} of {len(runs)}** recorded duels.",
        ">",
        f"> That tally counts separate experiments, not one: the records run {m['months_min']} to "
        f"{m['months_max']} months, {m['held_start']} of them from a held start, with bot revisions "
        f"and settings that changed between runs (each row's label names its change). In "
        f"{m['rival_without_rail']} of {len(runs)} the rival ran no train. Which rival each record ran "
        "against, and what company value counts and leaves out, is in the "
        "[duel evidence audit](research/duel-evidence-audit.md).",
        "",
        "```mermaid",
        "---",
        "config:",
        "  xyChart:",
        "    width: 900",
        "    height: 360",
        "  themeVariables:",
        "    xyChart:",
        f'      plotColorPalette: "{signal}, {grey}"',
        "---",
        "xychart-beta",
        f'    title "Seed {SEED}, {MONTHS} months: final company value per bot revision"',
        "    x-axis [" + ", ".join(f'"r{i + 1}"' for i in range(len(series))) + "]",
        f'    y-axis "Company value" 0 --> {((top // 100000) + 1) * 100000}',
        "    bar [" + ", ".join(str(r["a"]) for r in series) + "]",
        "    line [" + ", ".join(str(r["b"]) for r in series) + "]",
        "```",
        "",
        "<details><summary>Every revision in the chart (red bar: planned, grey line: unplanned)"
        "</summary>",
        "",
        "| Rev | Planned | Unplanned | What changed | Evidence |",
        "|---|---:|---:|---|---|",
    ]
    for i, r in enumerate(series):
        label = r["label"].replace("|", "/")
        label = label if len(label) <= 90 else label[:87].rstrip() + "..."
        lines.append(
            f"| r{i + 1} | {r['a']:,} | {r['b']:,} | {label} | "
            f"[{r['path'].stem}]({rel(r['path'].with_suffix('.md'))}) |"
        )
    lines += ["", "</details>", "", END]
    return "\n".join(lines)


def summary(runs, current):
    rel = lambda p: p.relative_to(ROOT).as_posix()
    best = max(runs, key=lambda r: r["a"])
    series = [r for r in runs if r["seed"] == SEED and r["months"] == MONTHS]
    row = lambda r: {"name": r["path"].stem, "seed": r["seed"], "months": r["months"], "label": r["label"],
                     "planned": r["a"], "unplanned": r["b"], "won": r["won"], "evidence": rel(r["path"].with_suffix(".md"))}
    return {"readme": "current" if current else "stale", "seed": SEED, "months": MONTHS,
            "duels": len(runs), "wins": sum(r["won"] for r in runs), "mix": mix(runs),
            "best": row(best), "series": [row(r) for r in series]}


def main():
    args = sys.argv[1:]
    if any(a in ("-h", "--help") for a in args):
        print(__doc__.strip())
        return
    unknown = [a for a in args if a not in ("--check", "--json")]
    if unknown or len(args) > 1:
        sys.stderr.write(f"readme-scoreboard: unknown or extra argument {' '.join(unknown or args[1:])}; "
                         "usage: readme-scoreboard [--check | --json]\n")
        sys.exit(2)
    text = README.read_text()
    if BEGIN not in text or END not in text:
        sys.exit(f"readme-scoreboard: markers missing in {README}")
    head, rest = text.split(BEGIN, 1)
    _, tail = rest.split(END, 1)
    new = head + render(load()) + tail
    if "--json" in args:
        print(json.dumps(summary(load(), new == text)))
        return
    if "--check" in args:
        sys.exit(0 if new == text else 11)
    README.write_text(new)


if __name__ == "__main__":
    main()
