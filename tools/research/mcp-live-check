#!/usr/bin/env bash
# RESEARCH-ONLY live check of the embedded MCP server (ADR 0008, issue I0017).
#
# Starts a headless dedicated server from an MCP-enabled build, starts the MCP server through
# the console, and drives it over loopback HTTP the way an MCP client would. It checks the
# security defaults (bearer auth, Origin rejection), live reads, and the approval state
# machine of the gated mutations (openttd.game.set_pause, and openttd.cmd.Pause from the derived
# command catalogue): pending -> operator approval in
# the console -> execution through the command system with the effect observed -> replay and
# changed arguments refused; and the same through openttd.decision.submit with the operator
# denying it: nothing changes, and the next submission asks again.
#
# The bearer token is read from the token file the server writes into a temporary directory that
# is removed on exit; it is never printed or written anywhere else.
#
# Usage: tools/research/mcp-live-check [--bin <openttd>] [--port <port>]
#   --bin   an openttd binary built with OPTION_PRISMATIC_MCP_SERVER=ON
#           (default: build-gate-research/openttd, as tools/gate.sh research leaves it)
#   --port  the loopback port for the MCP server (default 18731)
# Exit status: 0 every check passed, 1 a check failed, 2 usage, 3 a prerequisite is missing.
# Needs a base graphics set (see research/baseset-prerequisite-macos.md), curl and python3.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
BIN="$ROOT_DIR/build-gate-research/openttd"
PORT=18731

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bin) BIN="${2:?--bin needs a path}"; shift 2 ;;
    --port) PORT="${2:?--port needs a number}"; shift 2 ;;
    -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "mcp-live-check: unknown option: $1" >&2; exit 2 ;;
  esac
done

for tool in curl python3 strings; do
  command -v "$tool" >/dev/null 2>&1 || { echo "mcp-live-check: $tool is required" >&2; exit 3; }
done
[[ -x "$BIN" ]] || { echo "mcp-live-check: no executable at $BIN (run tools/gate.sh research)" >&2; exit 3; }
if [[ "$(strings "$BIN" | grep -c 'prismatic_mcp')" -eq 0 ]]; then
  echo "mcp-live-check: $BIN was not built with OPTION_PRISMATIC_MCP_SERVER=ON" >&2
  exit 3
fi

TMP="$(mktemp -d "${TMPDIR:-/tmp}/mcp-live-check.XXXXXX")"
FIFO="$TMP/console"
LOG="$TMP/server.log"
SERVER_PID=""
cleanup() {
  if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
    printf 'quit\n' >&3 2>/dev/null || true
    sleep 1
    kill "$SERVER_PID" 2>/dev/null || true
  fi
  exec 3>&- 2>/dev/null || true
  rm -rf "$TMP"
}
trap cleanup EXIT

PASS=0
FAIL=0
check() {
  local desc="$1" ok="$2"
  if [[ "$ok" == 1 ]]; then
    PASS=$((PASS + 1)); printf 'PASS  %s\n' "$desc"
  else
    FAIL=$((FAIL + 1)); printf 'FAIL  %s\n' "$desc"
  fi
}

# Wait up to $2 seconds for a fixed string in the server log.
wait_for() {
  local needle="$1" limit="$2" i
  for ((i = 0; i < limit * 4; i++)); do
    grep -qF -- "$needle" "$LOG" 2>/dev/null && return 0
    sleep 0.25
  done
  return 1
}

console() { printf '%s\n' "$1" >&3; }

ENDPOINT="http://127.0.0.1:$PORT/mcp"
# rpc <token> <json> [extra curl args...]: prints "<http status> <body>"
rpc() {
  local token="$1" body="$2"; shift 2
  local -a auth=()
  [[ -n "$token" ]] && auth=(-H "Authorization: Bearer $token")
  curl -s -o "$TMP/body" -w '%{http_code}' -X POST "$ENDPOINT" \
    -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
    ${auth[@]+"${auth[@]}"} "$@" --data "$body" || true
  printf ' '
  cat "$TMP/body" 2>/dev/null || true
}

# json_get <json> <python expression over d>: prints the value, empty on any error
json_get() {
  python3 -I -c 'import json, sys
try:
    d = json.loads(sys.argv[1])
    v = eval(sys.argv[2], {"d": d, "json": json})
    print(v if not isinstance(v, (dict, list)) else json.dumps(v))
except Exception:
    pass' "$1" "$2"
}

# The text payload of a tools/call result, parsed: prints the value of <key> in it.
tool_field() {
  json_get "$1" "json.loads(d['result']['content'][0]['text']).get('$2')"
}

echo "==> starting $BIN headless (dedicated, new random map)"
mkfifo "$FIFO"
"$BIN" -D -x -g -G 1 -c "$TMP/openttd.cfg" -d net=1 < "$FIFO" > "$LOG" 2>&1 &
SERVER_PID=$!
exec 3>"$FIFO"

# The console reads stdin only once the game loop runs, and a command sent before that can be
# lost (knowledge dedicated-server-stdin-startup-race), so repeat the start until it answers.
started=0
for ((i = 0; i < 60; i++)); do
  kill -0 "$SERVER_PID" 2>/dev/null || break
  console "prismatic_mcp start $PORT $TMP/token.json"
  if wait_for "MCP server started" 2 || wait_for "already running" 0; then started=1; break; fi
  if grep -qF "MCP server failed to start" "$LOG"; then break; fi
done
if [[ "$started" -ne 1 ]]; then
  echo "mcp-live-check: the MCP server did not start; last log lines:" >&2
  tail -5 "$LOG" >&2
  exit 1
fi
# The token comes from the token file `prismatic_mcp start <port> <file>` writes (the path the
# panel and the hub use), not from console text: a console line is worded for a person and may
# change (knowledge console-lines-the-panel-parses-are-an-interface).
for ((i = 0; i < 20; i++)); do [[ -s "$TMP/token.json" ]] && break; sleep 0.5; done
TOKEN="$(python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1]))["agent_token"])' "$TMP/token.json" 2>/dev/null || true)"
check "the server writes the operator a bearer token file" "$([[ "$TOKEN" =~ ^[0-9a-fA-F]{32,}$ ]] && echo 1 || echo 0)"
mode="$(stat -f %Lp "$TMP/token.json" 2>/dev/null || stat -c %a "$TMP/token.json" 2>/dev/null || true)"
check "the token file is readable by its owner only (mode $mode)" "$([[ "$mode" == 600 ]] && echo 1 || echo 0)"

PING='{"jsonrpc":"2.0","id":1,"method":"ping"}'
out="$(rpc "" "$PING")"
check "a request without a token is refused with 401" "$([[ "${out%% *}" == 401 ]] && echo 1 || echo 0)"
out="$(rpc "deadbeef" "$PING")"
check "a request with a wrong token is refused with 401" "$([[ "${out%% *}" == 401 ]] && echo 1 || echo 0)"
out="$(rpc "$TOKEN" "$PING" -H 'Origin: http://evil.example')"
check "a request carrying an Origin header is refused with 403" "$([[ "${out%% *}" == 403 ]] && echo 1 || echo 0)"

out="$(rpc "$TOKEN" '{"jsonrpc":"2.0","id":2,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"mcp-live-check","version":"1"}}}')"
proto="$(json_get "${out#* }" "d['result']['protocolVersion']")"
check "initialize negotiates protocol 2025-11-25 (got: ${proto:-none})" "$([[ "${out%% *}" == 200 && "$proto" == 2025-11-25 ]] && echo 1 || echo 0)"

READ_STATE='{"jsonrpc":"2.0","id":3,"method":"resources/read","params":{"uri":"openttd://game/state"}}'
state_field() { json_get "$1" "json.loads(d['result']['contents'][0]['text'])['data']['$2']"; }
# The envelope every resource answer carries (game_tick, game_date, source_revision, ...).
envelope_field() { json_get "$1" "json.loads(d['result']['contents'][0]['text'])['$2']"; }
out1="$(rpc "$TOKEN" "$READ_STATE")"
sleep 1
out2="$(rpc "$TOKEN" "$READ_STATE")"
t1="$(envelope_field "${out1#* }" game_tick)"; t2="$(envelope_field "${out2#* }" game_tick)"
check "resources/read returns live state: game_tick advances (${t1:-?} -> ${t2:-?})" \
  "$([[ -n "$t1" && -n "$t2" && "$t2" -gt "$t1" ]] && echo 1 || echo 0)"
paused0="$(state_field "${out2#* }" paused)"
check "the game starts unpaused (paused=${paused0:-?})" "$([[ "$paused0" == False ]] && echo 1 || echo 0)"

PAUSE='{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"openttd.game.set_pause","arguments":{"pause":true}}}'
out="$(rpc "$TOKEN" "$PAUSE")"
status="$(tool_field "${out#* }" status)"; approval="$(tool_field "${out#* }" approval_id)"
check "a mutation first returns pending_approval (status=${status:-?}, approval #${approval:-?})" \
  "$([[ "$status" == pending_approval && -n "$approval" ]] && echo 1 || echo 0)"
state_now="$(state_field "$(rpc "$TOKEN" "$READ_STATE" | cut -d' ' -f2-)" paused)"
check "nothing changed before the approval (paused=${state_now:-?})" "$([[ "$state_now" == False ]] && echo 1 || echo 0)"

console "prismatic_mcp approve $approval"
sleep 2
CHANGED='{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"openttd.game.set_pause","arguments":{"pause":false}}}'
out="$(rpc "$TOKEN" "$CHANGED")"
status="$(tool_field "${out#* }" status)"
check "changed arguments do not ride on the approval (status=${status:-?})" \
  "$([[ "$status" == pending_approval ]] && echo 1 || echo 0)"

out="$(rpc "$TOKEN" "$PAUSE")"
status="$(tool_field "${out#* }" status)"; result="$(tool_field "${out#* }" command_result)"
decision="$(tool_field "${out#* }" decision_id)"
# Posting is asynchronous: the command runs on a later tick, so the call answers "queued" (or
# already "succeeded") and the result is read back with openttd.decision.get once it has run.
check "the approved call is posted through the command system (status=${status:-?}, command_result=${result:-?})" \
  "$([[ "$status" == executed && ( "$result" == queued || "$result" == succeeded ) && -n "$decision" ]] && echo 1 || echo 0)"
sleep 1
paused1="$(state_field "$(rpc "$TOKEN" "$READ_STATE" | cut -d' ' -f2-)" paused)"
check "the effect is observed in the game (paused=${paused1:-?})" "$([[ "$paused1" == True ]] && echo 1 || echo 0)"
GET="{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"tools/call\",\"params\":{\"name\":\"openttd.decision.get\",\"arguments\":{\"decision_id\":${decision:-0}}}}"
out="$(rpc "$TOKEN" "$GET")"
result="$(tool_field "${out#* }" command_result)"; verdict="$(tool_field "${out#* }" verdict)"
check "openttd.decision.get reads the command's result once it ran (command_result=${result:-?}, verdict=${verdict:-?})" \
  "$([[ "$result" == succeeded && -n "$verdict" && "$verdict" != PENDING_OBSERVATION ]] && echo 1 || echo 0)"

out="$(rpc "$TOKEN" "$PAUSE")"
status="$(tool_field "${out#* }" status)"
check "replaying the approved call needs a fresh approval (status=${status:-?})" \
  "$([[ "$status" == pending_approval ]] && echo 1 || echo 0)"

# The same gate through a typed DecisionEnvelope, and the operator's other answer: denied, it
# changes nothing, and the next submission asks again instead of riding on the refusal.
SUBMIT='{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"openttd.decision.submit","arguments":{"action":{"type":"game.set_pause","arguments":{"pause":false}}}}}'
out="$(rpc "$TOKEN" "$SUBMIT")"
status="$(tool_field "${out#* }" status)"; approval="$(tool_field "${out#* }" approval_id)"
check "a submitted decision returns pending_approval (status=${status:-?}, approval #${approval:-?})" \
  "$([[ "$status" == pending_approval && -n "$approval" ]] && echo 1 || echo 0)"
console "prismatic_mcp deny $approval"
sleep 2
paused2="$(state_field "$(rpc "$TOKEN" "$READ_STATE" | cut -d' ' -f2-)" paused)"
check "a denied decision changes nothing (paused=${paused2:-?})" "$([[ "$paused2" == True ]] && echo 1 || echo 0)"
out="$(rpc "$TOKEN" "$SUBMIT")"
status="$(tool_field "${out#* }" status)"; again="$(tool_field "${out#* }" approval_id)"
check "after a denial the decision asks again (status=${status:-?}, approval #${again:-?})" \
  "$([[ "$status" == pending_approval && -n "$again" && "$again" != "$approval" ]] && echo 1 || echo 0)"

# A game command from the derived catalogue (openttd.cmd.<Name>, the command table's CmdPause):
# malformed parameters are refused before anything is asked; well-formed ones wait for the
# operator, run through the command system once approved, and their verdict is readable.
BAD='{"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"openttd.cmd.Pause","arguments":{"company":"server","params":[0]}}}'
out="$(rpc "$TOKEN" "$BAD")"
status="$(tool_field "${out#* }" status)"; valid="$(tool_field "${out#* }" valid)"
check "a catalogue command with the wrong parameters is refused, nothing asked (valid=${valid:-?}, status=${status:-none})" \
  "$([[ "$valid" == False && ( -z "$status" || "$status" == None ) ]] && echo 1 || echo 0)"
UNPAUSE='{"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"name":"openttd.cmd.Pause","arguments":{"company":"server","params":[0,false]}}}'
out="$(rpc "$TOKEN" "$UNPAUSE")"
status="$(tool_field "${out#* }" status)"; approval="$(tool_field "${out#* }" approval_id)"
check "a catalogue command first returns pending_approval (status=${status:-?}, approval #${approval:-?})" \
  "$([[ "$status" == pending_approval && -n "$approval" ]] && echo 1 || echo 0)"
console "prismatic_mcp approve $approval"
sleep 2
out="$(rpc "$TOKEN" "$UNPAUSE")"
status="$(tool_field "${out#* }" status)"; decision="$(tool_field "${out#* }" decision_id)"
check "the approved catalogue command is posted (status=${status:-?}, decision #${decision:-?})" \
  "$([[ "$status" == executed && -n "$decision" ]] && echo 1 || echo 0)"
sleep 2
paused3="$(state_field "$(rpc "$TOKEN" "$READ_STATE" | cut -d' ' -f2-)" paused)"
check "its effect is observed in the game (paused=${paused3:-?})" "$([[ "$paused3" == False ]] && echo 1 || echo 0)"
GET="{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"tools/call\",\"params\":{\"name\":\"openttd.decision.get\",\"arguments\":{\"decision_id\":${decision:-0}}}}"
out="$(rpc "$TOKEN" "$GET")"
result="$(tool_field "${out#* }" command_result)"; verdict="$(tool_field "${out#* }" verdict)"
check "openttd.decision.get reads its result and verdict (command_result=${result:-?}, verdict=${verdict:-?})" \
  "$([[ "$result" == succeeded && -n "$verdict" && "$verdict" != PENDING_OBSERVATION ]] && echo 1 || echo 0)"

# A command with a text parameter (CmdCreateGoal's EncodedString, spelled as a plain string),
# posted with game-script authority: approved, run, and its result read back.
GOAL='{"jsonrpc":"2.0","id":11,"method":"tools/call","params":{"name":"openttd.cmd.CreateGoal","arguments":{"company":"deity","params":[255,0,0,"Carry 500 t of coal"]}}}'
out="$(rpc "$TOKEN" "$GOAL")"
status="$(tool_field "${out#* }" status)"; approval="$(tool_field "${out#* }" approval_id)"
check "a command with a text parameter returns pending_approval (status=${status:-?}, approval #${approval:-?})" \
  "$([[ "$status" == pending_approval && -n "$approval" ]] && echo 1 || echo 0)"
console "prismatic_mcp approve $approval"
sleep 2
out="$(rpc "$TOKEN" "$GOAL")"
decision="$(tool_field "${out#* }" decision_id)"
sleep 2
GET="{\"jsonrpc\":\"2.0\",\"id\":12,\"method\":\"tools/call\",\"params\":{\"name\":\"openttd.decision.get\",\"arguments\":{\"decision_id\":${decision:-0}}}}"
out="$(rpc "$TOKEN" "$GET")"
result="$(tool_field "${out#* }" command_result)"
check "the text command runs once approved (decision #${decision:-?}, command_result=${result:-?})" \
  "$([[ -n "$decision" && "$result" == succeeded ]] && echo 1 || echo 0)"

# A command with a choice-of-types parameter (CmdCustomNewsItem's NewsReference, spelled
# {index, value}; index 1 is a tile) and a text, with game-script authority.
NEWS='{"jsonrpc":"2.0","id":13,"method":"tools/call","params":{"name":"openttd.cmd.CustomNewsItem","arguments":{"company":"deity","params":[17,255,{"index":1,"value":1000},"A news item from the MCP"]}}}'
out="$(rpc "$TOKEN" "$NEWS")"
status="$(tool_field "${out#* }" status)"; approval="$(tool_field "${out#* }" approval_id)"
check "a command with a choice-of-types parameter returns pending_approval (status=${status:-?})" \
  "$([[ "$status" == pending_approval && -n "$approval" ]] && echo 1 || echo 0)"
console "prismatic_mcp approve $approval"
sleep 2
out="$(rpc "$TOKEN" "$NEWS")"
decision="$(tool_field "${out#* }" decision_id)"
sleep 2
GET="{\"jsonrpc\":\"2.0\",\"id\":14,\"method\":\"tools/call\",\"params\":{\"name\":\"openttd.decision.get\",\"arguments\":{\"decision_id\":${decision:-0}}}}"
out="$(rpc "$TOKEN" "$GET")"
result="$(tool_field "${out#* }" command_result)"
check "the news command runs once approved (decision #${decision:-?}, command_result=${result:-?})" \
  "$([[ -n "$decision" && "$result" == succeeded ]] && echo 1 || echo 0)"

console "prismatic_mcp stop"
sleep 1
code="$(curl -s -o /dev/null -w '%{http_code}' -X POST "$ENDPOINT" --data "$PING" || true)"
check "after prismatic_mcp stop the listener is closed (http=$code)" "$([[ "$code" == 000 ]] && echo 1 || echo 0)"

printf '\nmcp-live-check: %d passed, %d failed\n' "$PASS" "$FAIL"
[[ "$FAIL" -eq 0 ]]
