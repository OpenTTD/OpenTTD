#!/usr/bin/env bash
# RESEARCH-ONLY: run the battle brain once (research/battle-brain.md). Exports the training rows from
# the post-mortem's DuckDB (analytics.duckdb, written by battle-postmortem), the GA's gene space from
# the battle's API, runs brain.exs on Nx/EXLA/Axon, and writes ~/ttd-battle/results/brain.json.
#
# Usage: tools/research/battle-brain/brain [--every SECONDS]   (--every: the background loop)
# Needs: duckdb CLI, Elixir with Nx, EXLA, Axon, Polaris and Jason compiled ($BRAIN_LIBS, default
# the prismatic-platform checkout's _build/dev/lib; its .tool-versions picks Elixir/Erlang).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESULTS="${BRAIN_RESULTS:-$HOME/ttd-battle/results}"
LIBS="${BRAIN_LIBS:-$HOME/dev/prismatic-platform/_build/dev/lib}"
BATTLE="${BRAIN_BATTLE:-http://127.0.0.1:8765}"
export ASDF_ELIXIR_VERSION="${ASDF_ELIXIR_VERSION:-1.19.0-otp-28}" ASDF_ERLANG_VERSION="${ASDF_ERLANG_VERSION:-28.1}"
EVERY=0
[[ "${1:-}" == "--every" ]] && EVERY="${2:?--every needs seconds}"

# Only the newest editions train the brain ($BRAIN_EDITIONS, default 10): before 46dd8814f9 every
# edition replayed the same 6-8 seeds, so older rows teach those maps, and "safe" picks learned
# there failed on fresh maps (GA g30.brainSafe/brainSafe1 each ended last once).
POSTMORTEM="${BRAIN_POSTMORTEM:-$HERE/../mcp-rhai/target/release/battle-postmortem}"
KEEP="${BRAIN_EDITIONS:-10}"
# The current cut: 2cab9e0314 makes air_level_step=0 the default (any height step until a levelled
# site is refused, then step 1), first edition 6590a606. Older editions are left out, not rebased.
# Previous cuts: 406a089b (fad8c1af62, step 2), 2d4e0173 (the levelling fix f4fcbbfef8).
BRAIN_TRAIN_SINCE="${BRAIN_TRAIN_SINCE-cd02f5e8f136daad}"
MIN_ROWS="${BRAIN_MIN_ROWS:-20}"
BASELINE_SINCE="${BRAIN_BASELINE_SINCE:-cd02f5e8f136daad}"
REBASE="${BRAIN_BASELINE_REBASE:-1.154}"

once() {
  local tmp; tmp="$(mktemp -d)"
  # The cut is applied to every edition in the store first, then the newest $KEEP are kept: a cut
  # edition that has scrolled out of the newest $KEEP still bounds the data (it used to read as
  # "not recorded yet" and empty the brain).
  local all; all="$("$POSTMORTEM" editions)"
  # A behaviour change that interacts with the genes (not a uniform shift) cannot be rebased by one
  # factor: $BRAIN_TRAIN_SINCE drops every edition older than the named one (newest first).
  # An edition not yet in the store means nothing since the cut has been recorded.
  if [[ -n "${BRAIN_TRAIN_SINCE:-}" ]]; then
    if grep -qx "$BRAIN_TRAIN_SINCE" <<<"$all"; then all="$(awk -v e="$BRAIN_TRAIN_SINCE" '{print} $0==e{exit}' <<<"$all")"; else all=""; fi
  fi
  all="$(head -n "$KEEP" <<<"$all")"
  # Backfill: an edition the post-mortem watch missed (it was not running) has no analyses in
  # DuckDB; run the post-mortem for it here, so the brain never trains on a silently shrunken window.
  local e n
  for e in $all; do
    n="$(duckdb -readonly "$RESULTS/analytics.duckdb" -noheader -csv "SELECT count(*) FROM analyses WHERE edition = '$e'" 2>/dev/null || echo 0)"
    [[ "$n" == "0" ]] && "$POSTMORTEM" --edition "$e" --out "$RESULTS" >/dev/null 2>&1 && echo "battle-brain: backfilled post-mortem $e"
  done
  local eds; eds="$(sed "s/.*/'&'/" <<<"$all" | paste -sd, -)"
  [[ -n "$all" ]] || eds="'none'"
  # The default the target pairs against changed in 6111dc0fef (the GA's elite); the first edition
  # with it is $BASELINE_SINCE. Older rows paired against the former default, so they are rebased by
  # the measured ratio of the elite over it ($BASELINE_REBASE: geometric mean 1.12 over 40 new maps).
  local cur; cur="$(awk -v e="$BASELINE_SINCE" '{print} $0==e{exit}' <<<"$all" | sed "s/.*/'&'/" | paste -sd, -)"
  grep -qx "$BASELINE_SINCE" <<<"$all" || cur="$eds"
  # The target is paired: a variant's value share divided by the default PrismaticAI's on the same
  # edition and seed (the signal that held: GA g14.0 won 20/20 paired seeds). Unpaired rows are left out.
  duckdb -readonly "$RESULTS/analytics.duckdb" -csv \
    "WITH a AS (SELECT a.edition, a.seed, a.contestant, c.settings, a.value_share_of_winner AS s
                FROM analyses a JOIN contestants c USING (edition, contestant)
                WHERE c.prismatic AND a.value_share_of_winner > 0 AND a.seed IS NOT NULL AND a.edition IN ($eds)),
          d AS (SELECT edition, seed, s FROM a WHERE contestant = 'PrismaticAI')
     SELECT a.edition, a.contestant, a.settings,
            a.s / d.s / (CASE WHEN a.edition IN ($cur) THEN 1.0 ELSE $REBASE END) AS share
     FROM a JOIN d USING (edition, seed) WHERE a.contestant <> 'PrismaticAI'" > "$tmp/rows.csv"
  local n; n=$(( $(wc -l < "$tmp/rows.csv") - 1 ))
  if (( n < MIN_ROWS )); then
    # Too little data since the cut: withdraw the proposals instead of fitting noise. The GA takes
    # no brain offspring while brain.json is absent (battle.py brain_proposals).
    [[ -f "$RESULTS/brain.json" ]] && mv "$RESULTS/brain.json" "$RESULTS/brain.withdrawn.json"
    echo "battle-brain: $n paired rows since ${BRAIN_TRAIN_SINCE:-the start} (< $MIN_ROWS): no proposals"
    rm -rf "$tmp"; return 0
  fi
  export BRAIN_TARGET="paired: value share / the default PrismaticAI's on the same edition and seed; the newest $KEEP editions; editions before $BASELINE_SINCE rebased by 1/$REBASE (default changed in 962699034c, g150.0)"
  # The battle API can be down (orchestrator restart): skip this round rather than feed brain.exs
  # an empty gene space (it used to die with a Jason.DecodeError).
  if ! curl -fsS -m 10 "$BATTLE/api/tuning" > "$tmp/space.json" || ! [[ -s "$tmp/space.json" ]]; then
    echo "battle-brain: battle API $BATTLE unavailable: skipped this round" >&2; rm -rf "$tmp"; return 1
  fi
  local args=()
  for l in nx exla axon polaris complex telemetry xla elixir_make nimble_pool jason; do args+=(-pa "$LIBS/$l/ebin"); done
  (cd "$tmp" && elixir "${args[@]}" "$HERE/brain.exs" "$tmp/rows.csv" "$tmp/space.json" "$tmp/brain.json")
  mv "$tmp/brain.json" "$RESULTS/brain.json"
  rm -rf "$tmp"
}

if (( EVERY > 0 )); then
  while true; do once || echo "battle-brain: run failed" >&2; sleep "$EVERY"; done
else
  once
fi
