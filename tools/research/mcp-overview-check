#!/usr/bin/env node
// RESEARCH-ONLY. The panel's overview checked in a real browser: every registered chart
// (static/overview.js CHARTS) has an instance with a non-zero width whose series carry data, the
// history comes from the panel (GET /api/overview/history), maximize puts `max` in the address and
// Escape restores it, the metric survives a reload of the address, a click on a company focuses it
// (ov_focus), a phone-width page does not scroll sideways, the World page's charts still come
// through the one door, a tool page builds its form from the schema, and the console stays free
// of errors, and /data runs the query in its address (skipped, and said so, on a panel without the
// event store). Drives the installed Chrome through playwright-core (npm ci in tools/research/mcp-panel).
//
// Usage: tools/research/mcp-overview-check http://127.0.0.1:<panel-port>   (exit 0 PASS, 1 FAIL)
import { createRequire } from 'node:module';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

const here = path.dirname(fileURLToPath(import.meta.url));
const require = createRequire(path.join(here, 'mcp-panel', 'package.json'));
const { chromium } = require('playwright-core');
const CHROME = process.env.CHROME || '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome';

const base = (process.argv[2] || '').replace(/\/$/, '');
if (!base) { console.error('usage: mcp-overview-check <panel-url>'); process.exit(2); }
const checks = [];
const skipped = [];
const check = (name, ok, detail = '') => { checks.push(ok); console.log(`${ok ? 'PASS' : 'FAIL'} ${name}${detail ? ` (${detail})` : ''}`); };

const charts = (page) => page.evaluate(async () => {
  const { CHARTS } = await import('/static/overview.js');
  return CHARTS.map((c) => {
    const box = document.getElementById(c.id);
    const inst = box && globalThis.echarts.getInstanceByDom(box);
    const series = inst ? inst.getOption().series || [] : [];
    return { id: c.id, width: box ? box.offsetWidth : 0, points: series.reduce((n, s) => n + (s.data || []).length, 0), series: series.length };
  });
});

const browser = await chromium.launch({ executablePath: CHROME, headless: true, args: ['--enable-unsafe-swiftshader'] });
try {
  const page = await browser.newPage({ viewport: { width: 1600, height: 1400 } });
  // Without a GUI client the client's own routes answer 503 by design; every other failed request
  // and every script error counts, by URL.
  const noClient = (await fetch(`${base}/api/view/screenshot`)).status === 503;
  const guiOnly = /\/api\/(news|ask|view\/screenshot)(\?|$)/;
  const errors = [];
  const watch = (pg) => {
    pg.on('pageerror', (e) => errors.push(e.message));
    pg.on('response', (r) => {
      if (r.status() < 400) return;
      if (noClient && r.status() === 503 && guiOnly.test(r.url())) return;
      errors.push(`HTTP ${r.status()} ${r.url()}`);
    });
    pg.on('console', (m) => { if (m.type() === 'error' && !/^Failed to load resource/.test(m.text())) errors.push(m.text()); });
  };
  watch(page);

  // A fresh game has no company until its AI founds one; the company charts are judged after that.
  let hist = { count: 0, samples: [] };
  for (let i = 0; i < 60; i++) {
    hist = await (await fetch(`${base}/api/overview/history`)).json();
    if (hist.samples.length && hist.samples.at(-1).companies.length) break;
    await new Promise((r) => setTimeout(r, 2000));
  }
  check('the panel keeps a history with a company', hist.count > 0 && hist.samples.at(-1).companies.length > 0,
    `${hist.count} game day(s), last tick ${hist.last}, ${hist.samples.at(-1)?.companies.length ?? 0} company(ies)`);

  await page.goto(`${base}/?ov_metric=value`);
  await page.waitForFunction(() => {
    const b = document.getElementById('ov-companies');
    const i = b && globalThis.echarts && globalThis.echarts.getInstanceByDom(b);
    return i && (i.getOption().series || []).some((s) => (s.data || []).length > 0);
  }, null, { timeout: 30000 }).catch(() => {});
  for (const c of await charts(page)) check(`${c.id} is drawn with data`, c.width > 0 && c.points > 0, `width ${c.width}, ${c.series} series, ${c.points} points`);
  check('the metric comes from the address', (await page.inputValue('#ov-metric')) === 'value');

  await page.selectOption('#ov-range', '90');
  await page.reload();
  await page.waitForTimeout(800);
  check('the range survives a reload', (await page.inputValue('#ov-range')) === '90', page.url());

  const max = page.locator('#ov-companies-card [data-toolbar] button', { hasText: 'Maximize' });
  await max.click();
  await page.waitForTimeout(300);
  const maxed = new URL(page.url()).searchParams.get('max');
  const w = await page.evaluate(() => document.getElementById('ov-companies').offsetWidth);
  check('maximize puts max in the address and fills the viewport', maxed === 'ov-companies' && w > 1400, `max=${maxed}, width ${w}`);
  await page.keyboard.press('Escape');
  await page.waitForTimeout(300);
  check('Escape restores', !new URL(page.url()).searchParams.get('max'));

  // With several companies a bar of the standing chart is a company; with one, that chart is the
  // company's balance sheet (8a57a453ab) and the company is a line of the companies chart.
  const focused = await page.evaluate(() => {
    const inst = globalThis.echarts.getInstanceByDom(document.getElementById('ov-standing'));
    const bar = inst.getOption().series[0].data.at(-1);
    if (bar && bar.id) {
      inst.trigger('click', { data: bar, componentType: 'series' });
      return bar.id;
    }
    const co = globalThis.echarts.getInstanceByDom(document.getElementById('ov-companies'));
    const line = co.getOption().series[0];
    co.trigger('click', { seriesId: line.id, componentType: 'series' });
    return line.id;
  });
  await page.waitForTimeout(300);
  check('a click on a company focuses it', new URL(page.url()).searchParams.get('ov_focus') === String(focused), `ov_focus=${new URL(page.url()).searchParams.get('ov_focus')}`);

  // The owner's complaint of 2026-11-17: the controls looked mismatched and #overview landed under
  // the navbar. A select keeps room for its chevron (Flowbite's pe-9, not p-2), every control of a
  // card's header is one height, and the linked section clears the navbar after the cards above load.
  const look = await page.evaluate(() => {
    const px = (e, k) => parseFloat(getComputedStyle(e)[k]);
    const sel = [...document.querySelectorAll('#overview select')];
    const ctl = [...sel, ...document.querySelectorAll('#overview [data-toolbar] button')].filter((e) => e.offsetHeight);
    return { chevron: Math.min(...sel.map((e) => px(e, 'paddingRight'))), heights: [...new Set(ctl.map((e) => e.offsetHeight))] };
  });
  check('a select keeps room for its chevron', look.chevron >= 28, `padding-right ${look.chevron}px`);
  check("the overview's controls are one height", look.heights.length === 1, `heights ${look.heights.join(', ')}`);
  // 2026-11-18: a long note pushed Maximize under it in three cards; at desktop width every card's
  // toolbar sits on its title's row.
  const heads = await page.evaluate(() => [...document.querySelectorAll('#overview [data-chart]')].map((card) => {
    const bar = card.querySelector('[data-toolbar]');
    const title = card.querySelector('h2');
    return bar && title && bar.offsetHeight ? [card.id, Math.round(bar.getBoundingClientRect().top - title.getBoundingClientRect().top)] : [card.id, null];
  }));
  check("every overview card's toolbar is on its title's row", heads.every(([, d]) => d !== null && Math.abs(d) <= 12), heads.map(([id, d]) => `${id} ${d}`).join(', '));
  const anchored = await browser.newPage({ viewport: { width: 1440, height: 1000 } });
  watch(anchored);
  await anchored.goto(`${base}/#overview`);
  await anchored.waitForTimeout(4000);
  const lands = await anchored.evaluate(() => ({
    nav: Math.round(document.querySelector('nav').getBoundingClientRect().bottom),
    top: Math.round(document.getElementById('overview').getBoundingClientRect().top),
  }));
  check('#overview lands just below the navbar', lands.top >= lands.nav && lands.top <= lands.nav + 40, `section top ${lands.top}, navbar ${lands.nav}`);
  await anchored.route('**/api/overview/history*', (r) => r.fulfill({ contentType: 'application/json',
    body: JSON.stringify({ count: 2, last: 148, samples: [0, 1].map((i) => ({ t: 74 * (i + 1), date: `1950-01-0${i + 2}`, vehicles: 0, towns: 9, paused: false, companies: [] })) }) }));
  await anchored.goto(`${base}/`);
  await anchored.waitForTimeout(1500);
  const empty = await anchored.evaluate(() => ['ov-companies-empty', 'ov-standing-empty'].map((id) => document.getElementById(id)?.offsetHeight > 0));
  check('a game without a company says so instead of an empty frame', empty.every(Boolean), `visible ${empty.join(', ')}`);
  await anchored.close();

  // My bot, the owner's second complaint of 2026-11-17 (4073px of controls, an Apply under every
  // field): a fictional running bot served to the page, whose fr_/fr2_/fr3_ settings must become one
  // table of lines with the unused one folded, and whose edits are counted by one Apply per bot.
  const botPage = await browser.newPage({ viewport: { width: 1440, height: 1000 } });
  watch(botPage);
  const st = (name, value, description = 'a number') => ({ name, value, default: value, min: -1, max: 100, step: 1, flags: ['in_game'], ingame: true, editable: true, labels: {}, description });
  const line = (p, f, t, c) => [st(`${p}_from`, f, 'Producing industry (industry id; -1: none)'), st(`${p}_to`, t, 'Accepting industry (industry id; -1: none)'), st(`${p}_cargo`, c, 'Cargo (cargo id; -1: none)')];
  const fixture = { source: 'fixture', live: { list: true, set_setting: true }, ais: [{ ai: 'FictionalAI', settings: [] }],
    running: [{ id: 7, name: 'Fictional Freight', ai: 'FictionalAI', money: 1000, settings: [st('max_routes', 4), st('air_a', 1), st('air_b', 2), ...line('fr', 1, 2, 1), ...line('fr2', 2, 1, 1), ...line('fr3', -1, -1, -1)] }] };
  const posts = [];
  botPage.on('request', (r) => { if (r.method() === 'POST' && r.url().includes('/api/bots')) posts.push(r.url()); });
  await botPage.route('**/api/bots', (r) => r.fulfill({ contentType: 'application/json', body: JSON.stringify(fixture) }));
  await botPage.route('**/api/bots/choices', (r) => r.fulfill({ contentType: 'application/json', body: JSON.stringify({ town: [], cargo: [{ id: 1, name: 'Ore' }], industry: [{ id: 1, name: 'Mine', produces: ['Ore'] }, { id: 2, name: 'Mill', produces: [] }] }) }));
  await botPage.goto(`${base}/#bot`);
  await botPage.waitForSelector('#bot-running [data-bot="7"] select[data-picker]', { timeout: 8000 }).catch(() => {});
  const bot = await botPage.evaluate(() => ({
    applies: document.querySelectorAll('#bot-running [data-apply-bot]').length,
    perField: document.querySelectorAll('#bot-running [data-apply]').length,
    lines: document.querySelectorAll('#bot-running [data-lines="fr"] [data-line]').length,
    folded: document.querySelectorAll('#bot-running [data-unused] [data-line]').length,
  }));
  check('a running bot has one Apply, none per field', bot.applies === 1 && bot.perField === 0, `${bot.applies} per bot, ${bot.perField} per field`);
  check('numbered settings form one table of lines, the unused one folded', bot.lines === 3 && bot.folded === 1, `${bot.lines} lines, ${bot.folded} folded`);
  await botPage.fill('#set-c7-max_routes', '6').catch(() => {});
  const pending = await botPage.evaluate(() => document.querySelector('#bot-running [data-pending]')?.textContent);
  check('an edit is counted with the approvals Apply will ask, and sends nothing', pending === '1 change, 1 approval' && posts.length === 0, `"${pending}", ${posts.length} post(s)`);
  await botPage.close();

  const phone = await browser.newPage({ viewport: { width: 390, height: 844 } });
  watch(phone);
  await phone.goto(`${base}/`);
  await phone.waitForTimeout(1500);
  const sideways = await phone.evaluate(() => document.documentElement.scrollWidth - window.innerWidth);
  check('a phone-width page does not scroll sideways', sideways <= 0, `${sideways}px over`);
  const phoneCharts = await charts(phone);
  check('the charts are drawn at phone width', phoneCharts.every((c) => c.width > 0 && c.width <= 390), phoneCharts.map((c) => `${c.id} ${c.width}`).join(', '));

  await page.goto(`${base}/world`);
  await page.waitForTimeout(2500);
  const world = await page.evaluate(() => [...document.querySelectorAll('[role="img"]')].filter((b) => globalThis.echarts.getInstanceByDom(b)).length);
  check('the World page draws its charts through the one door', world > 0, `${world} chart(s)`);

  await page.goto(`${base}/tool/openttd.ai.set_setting`);
  await page.waitForSelector('#call [data-key]', { timeout: 15000 }).catch(() => {});
  const fields = await page.$$eval('#call [data-key]', (els) => els.map((e) => e.dataset.key));
  check('a tool page builds its form from the schema', fields.join(',') === 'company,name,value', fields.join(','));

  // The duels: the list's chart has one pair of bars per run and a bar leads to the run's page,
  // whose chart is drawn and whose measure survives a reload of the address.
  await page.goto(`${base}/results`);
  await page.waitForFunction(() => { const b = document.getElementById('duels-chart'); const i = b && globalThis.echarts.getInstanceByDom(b);
    return i && (i.getOption().series || [])[0]?.data?.length > 0; }, null, { timeout: 15000 }).catch(() => {});
  const bars = await page.evaluate(() => { const i = globalThis.echarts.getInstanceByDom(document.getElementById('duels-chart'));
    return i ? i.getOption().series[0].data.length : 0; });
  const rows = await page.$$eval('#duels-rows tr', (r) => r.length);
  check('the duel list charts every run', bars > 0 && bars === rows, `${bars} bars, ${rows} rows`);
  const target = await page.evaluate(() => { const i = globalThis.echarts.getInstanceByDom(document.getElementById('duels-chart'));
    const bar = i.getOption().series[0].data.at(-1); i.trigger('click', { data: bar, componentType: 'series' }); return bar.name; });
  await page.waitForURL(/\/result\//, { timeout: 10000 }).catch(() => {});
  check('a bar leads to its run', page.url().endsWith('/result/' + target), page.url());
  await page.goto(`${base}/result/${target}?metric=trains`);
  await page.waitForTimeout(1200);
  const duel = await page.evaluate(() => { const i = globalThis.echarts.getInstanceByDom(document.getElementById('duel-chart'));
    return i ? { series: i.getOption().series.length, points: i.getOption().series[0].data.length, metric: document.getElementById('metric').value } : null; });
  check('a run page draws both companies by the measure in the address', duel && duel.series === 2 && duel.points > 0 && duel.metric === 'trains', JSON.stringify(duel));

  // Runs side by side: ticking two runs puts them in the address and draws four lines (A and B each).
  await page.goto(`${base}/results`);
  await page.waitForSelector('#duels-rows input[data-cmp]', { timeout: 15000 }).catch(() => {});
  const boxes = await page.$$('#duels-rows input[data-cmp]');
  for (const b of boxes.slice(0, 2)) await b.check();
  await page.waitForTimeout(1500);
  const picked = (new URL(page.url()).searchParams.get('compare') || '').split(',').filter(Boolean);
  const lines = await page.evaluate(() => { const i = globalThis.echarts.getInstanceByDom(document.getElementById('compare-chart'));
    return i ? (i.getOption().series || []).length : -1; });
  check('ticked runs are compared, and kept in the address', picked.length === 2 && lines === 4, `compare=${picked.join(',')}, ${lines} lines`);
  await page.reload();
  await page.waitForTimeout(1500);
  const again = await page.evaluate(() => { const i = globalThis.echarts.getInstanceByDom(document.getElementById('compare-chart'));
    return [i ? (i.getOption().series || []).length : -1, document.querySelectorAll('#duels-rows input[data-cmp]:checked').length]; });
  check('a comparison survives a reload of its address', again[0] === 4 && again[1] === 2, `${again[0]} lines, ${again[1]} ticked`);

  // The event store's page (ADR 0033): a query in the address runs on load and answers a row. A
  // panel without the store (no /api/db/query yet, or the store off) is skipped and says so; a skip
  // is not a pass and is counted apart.
  const probe = await fetch(`${base}/api/db/query?sql=${encodeURIComponent('SELECT 1')}`).catch(() => null);
  const storeless = !probe ? 'the panel did not answer' : probe.status === 404 ? 'GET /api/db/query answers 404: this panel has no event store route yet'
    : probe.status === 503 ? 'GET /api/db/query answers 503: the store is off in this panel' : '';
  if (storeless) {
    skipped.push('/data');
    console.log(`SKIP /data runs the query in its address (${storeless})`);
  } else {
    const sql = 'SELECT count(*) FROM events';
    await page.goto(`${base}/data?sql=${encodeURIComponent(sql)}`);
    await page.waitForSelector('#data-rows tr[data-row]', { timeout: 15000 }).catch(() => {});
    const data = await page.evaluate(() => {
      const err = document.getElementById('query-error');
      return { sql: document.getElementById('sql')?.value, rows: [...document.querySelectorAll('#data-rows tr[data-row]')].map((r) => r.textContent.trim()),
        error: err && !err.classList.contains('hidden') ? err.textContent : '' };
    });
    check('/data runs the query in its address and answers a row', data.sql === sql && data.rows.length === 1 && /^\d+$/.test(data.rows[0] || ''),
      `sql "${data.sql}", rows ${JSON.stringify(data.rows)}${data.error ? `, error: ${data.error}` : ''}`);
  }

  check('the console stays free of errors', errors.length === 0, errors.slice(0, 3).join(' | '));
} finally {
  await browser.close();
}
const failed = checks.filter((c) => !c).length;
console.log(`\nmcp-overview-check: ${checks.length - failed} passed, ${failed} failed${skipped.length ? `, ${skipped.length} skipped (${skipped.join(', ')})` : ''}`);
process.exit(failed ? 1 : 0);
