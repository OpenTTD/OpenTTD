#!/usr/bin/env bash
# RESEARCH-ONLY: end-to-end check of what the owner sees and drives, against a running
# tools/research/mcp-e2e stack (panel plus a GUI client with its own MCP server).
#
# Checks the news in the owner's window (show, list, event, close), plan parameters, discovery (every registered instance probed, calls across the cluster), the live view (screenshots of the owner's window, repeated, with the client still alive),
# the view tools through the panel proxy (scroll_to, mark, an unknown tool refused), the world
# resources and the derived graph, and that these routes are in OpenAPI without a hand entry.
#
# Usage: tools/research/mcp-view-check [panel-url]   (default http://127.0.0.1:8800)
# Exit: 0 all passed, 1 a check failed, 2 the panel is not reachable.
set -euo pipefail

URL="${1:-http://127.0.0.1:8800}"
PASS=0
FAIL=0
check() {
  local desc="$1" ok="$2"
  if [[ "$ok" == 1 ]]; then
    PASS=$((PASS + 1)); printf 'PASS  %s\n' "$desc"
  else
    FAIL=$((FAIL + 1)); printf 'FAIL  %s\n' "$desc"
  fi
}
json() { python3 -I -c "import json,sys; d=json.load(sys.stdin); print(eval(sys.argv[1], {'d': d}))" "$1"; }
tool() {
  curl -s -X POST -H 'Content-Type: application/json' \
    -d "{\"name\":\"$1\",\"arguments\":${2:-{\}}}" "$URL/api/view/tool"
}

curl -s -o /dev/null --max-time 5 "$URL/api/status" || { echo "mcp-view-check: no panel at $URL" >&2; exit 2; }
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

attached="$(curl -s "$URL/api/status" | json "any(e['kind']=='view' for e in d['events'])")"
check "a GUI client is attached to the panel" "$([[ "$attached" == True ]] && echo 1 || echo 0)"

for n in 1 2 3 4 5; do
  curl -s -o "$TMP/shot$n" "$URL/api/view/screenshot"
done
pngs=0
for n in 1 2 3 4 5; do
  [[ "$(head -c 8 "$TMP/shot$n" | od -An -tx1 | tr -d ' \n')" == 89504e470d0a1a0a ]] && pngs=$((pngs + 1))
done
check "five live screenshots in a row are PNG images ($pngs/5)" "$([[ "$pngs" == 5 ]] && echo 1 || echo 0)"
state="$(tool openttd.view.state)"
check "the GUI client survives the screenshots (view.state answers)" \
  "$([[ "$(json "d.get('ok')" <<<"$state")" == True ]] && echo 1 || echo 0)"

out="$(tool openttd.view.scroll_to '{"x":64,"y":64,"instant":true}')"
check "view.scroll_to through the panel proxy centres the camera on (64,64)" \
  "$([[ "$(json "(d.get('x'), d.get('y'))" <<<"$out")" == "(64, 64)" ]] && echo 1 || echo 0)"
out="$(tool openttd.view.mark '{"x":64,"y":64}')"
check "view.mark puts the cursor on (64,64)" \
  "$([[ "$(json "d.get('marked') is not None and (d.get('x'), d.get('y')) == (64, 64)" <<<"$out")" == True ]] && echo 1 || echo 0)"
out="$(tool openttd.view.no_such_tool)"
check "an unknown view tool is refused with an error" \
  "$([[ "$(json "d.get('ok') is False and 'error' in d" <<<"$out")" == True ]] && echo 1 || echo 0)"

map="$(curl -s "$URL/api/resources/map")"
check "openttd://map has one row of types, heights and owners per map row" \
  "$([[ "$(json "(lambda m: len(m['types'])==len(m['heights'])==len(m['owners'])==m['height'] and len(m['types'][0])==m['width'] and len(m['heights'][0])==2*m['width'])(d['data'])" <<<"$map")" == True ]] && echo 1 || echo 0)"
st="$(curl -s "$URL/api/resources/stations")"
check "openttd://stations answers a list" \
  "$([[ "$(json "isinstance(d['data']['stations'], list)" <<<"$st")" == True ]] && echo 1 || echo 0)"
graph="$(curl -s "$URL/api/graph")"
check "the road graph has nodes, edges that point at nodes, and components" \
  "$([[ "$(json "(lambda ids: len(ids) > 0 and all(e['source'] in ids and e['target'] in ids for e in d['edges']) and d['stats']['components'] > 0)({n['id'] for n in d['nodes']})" <<<"$graph")" == True ]] && echo 1 || echo 0)"

plan="$(curl -s "$URL/api/plan?limit=5")"
check "the route plan ranks pairs with a mode each (bus, rail or air), best first, and the best per mode" \
  "$([[ "$(json "len(d['pairs']) > 0 and all(p['mode'] in ('bus','rail','air') for p in d['pairs']) and [p['score'] for p in d['pairs']] == sorted([p['score'] for p in d['pairs']], reverse=True) and set(d['by_mode']) == {'bus','rail','air'}" <<<"$plan")" == True ]] && echo 1 || echo 0)"

plan="$(curl -s "$URL/api/plan?limit=5&params=%7B%22modes%22%3A%5B%22bus%22%5D%7D")"
check "plan parameters from the caller are applied and echoed (modes=[bus] gives only bus pairs)" \
  "$([[ "$(json "d['params']['modes'] == ['bus'] and all(p['mode'] == 'bus' for p in d['pairs'])" <<<"$plan")" == True ]] && echo 1 || echo 0)"
code="$(curl -s -o /dev/null -w '%{http_code}' "$URL/api/plan?params=not-json")"
check "a plan with parameters that are not JSON is refused with 400 (http=$code)" "$([[ "$code" == 400 ]] && echo 1 || echo 0)"

since="$(curl -s "$URL/api/status" | json "d['event_seq']")"
stamp="mcp-view-check $(date +%s)"
out="$(curl -s -X POST -H 'Content-Type: application/json' -d "{\"text\":\"$stamp\",\"x\":64,\"y\":64}" "$URL/api/news")"
check "POST /api/news shows a message in the owner's window (style thin with a viewport)" \
  "$([[ "$(json "d.get('ok') is True and d.get('style') == 'thin'" <<<"$out")" == True ]] && echo 1 || echo 0)"
listed=0
for _ in 1 2 3 4 5; do
  curl -s "$URL/api/news?limit=5" | grep -q "$stamp" && { listed=1; break; }
  sleep 1
done
check "the message is in the client's news list (GET /api/news)" "$listed"
streamed=0
for _ in $(seq 1 8); do
  curl -s "$URL/api/events?since=$since&kinds=news" | grep -q "$stamp" && { streamed=1; break; }
  sleep 1
done
check "the message arrives as an event news.shown on the event feed" "$streamed"
out="$(curl -s -X POST -H 'Content-Type: application/json' -d '{"text":"x","style":"small"}' "$URL/api/news")"
check "a small news without a viewport target is refused" \
  "$([[ "$(json "d.get('ok') is False" <<<"$out")" == True ]] && echo 1 || echo 0)"
out="$(curl -s -X POST "$URL/api/news/close")"
check "POST /api/news/close closes the news window" "$([[ "$(json "d.get('ok')" <<<"$out")" == True ]] && echo 1 || echo 0)"

company="$(curl -s "$URL/api/resources/companies" | json "d['data']['companies'][0]['id'] if d['data']['companies'] else -1")"
out="$(curl -s -X POST -H 'Content-Type: application/json' -d "{\"text\":\"mcp-view-check company news\",\"style\":\"company\",\"company\":$company,\"title\":\"launch\"}" "$URL/api/news")"
check "a company newspaper with the manager's face is shown for company $company" \
  "$([[ "$(json "d.get('ok') is True and d.get('style') == 'company'" <<<"$out")" == True ]] && echo 1 || echo 0)"
out="$(curl -s -X POST -H 'Content-Type: application/json' -d '{"text":"x","style":"company","company":99}' "$URL/api/news")"
check "a company newspaper for a company that does not exist is refused" \
  "$([[ "$(json "d.get('ok') is False" <<<"$out")" == True ]] && echo 1 || echo 0)"
curl -s -X POST "$URL/api/news/close" >/dev/null

since="$(curl -s "$URL/api/status" | json "d['event_seq']")"
q1="$(curl -s -X POST -H 'Content-Type: application/json' -d '{"question":"mcp-view-check: first question (replaced at once)"}' "$URL/api/ask" | json "d.get('id')")"
q2="$(curl -s -X POST -H 'Content-Type: application/json' -d '{"question":"mcp-view-check: a test question in your game window; any answer is fine"}' "$URL/api/ask" | json "d.get('id')")"
answers="$(curl -s "$URL/api/ask")"
check "POST /api/ask opens the game's query dialog; a newer question replaces the older one (#$q1 replaced, #$q2 open)" \
  "$([[ "$(json "(lambda by: by.get($q1) == 'replaced' and $q2 in by and by[$q2] is None)({a['id']: a['answer'] for a in d['asks']})" <<<"$answers")" == True ]] && echo 1 || echo 0)"
streamed=0
for _ in $(seq 1 8); do
  curl -s "$URL/api/events?since=$since&kinds=ask" | grep -q 'first question (replaced' && { streamed=1; break; }
  sleep 1
done
check "the answer arrives as an event ask.answered on the event feed" "$streamed"

# The owner's sentences: nouns from the game's own language files, answered over the live world.
out="$(curl -s -X POST -H 'Content-Type: application/json' -d '{"text":"najdi nejbližší les + pilu"}' "$URL/api/intent")"
check "a Czech sentence is understood from the game's own words (les -> Forest, pilu -> Sawmill), pairs nearest first" \
  "$([[ "$(json "(lambda i, a: i['language'] == 'czech' and [x['name'] for x in i['subjects']] == ['Forest', 'Sawmill'] and i['ordering'] == 'nearest' and [c['distance'] for c in a['candidates']] == sorted(c['distance'] for c in a['candidates']))(d['intent'], d['answer'])" <<<"$out")" == True ]] && echo 1 || echo 0)"
out="$(curl -s -X POST -H 'Content-Type: application/json' -d '{"text":"vybuduj nejlukrativnější trať"}' "$URL/api/intent")"
check "a build sentence returns candidates by score and the bot settings that carry out the first" \
  "$([[ "$(json "d['intent']['action'] == 'build' and d['answer']['ordering'] == 'most_profitable' and bool(d['answer']['build']['settings'])" <<<"$out")" == True ]] && echo 1 || echo 0)"
code="$(curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' -d '{}' "$URL/api/intent")"
check "an intent without text is refused with 400 (http=$code)" "$([[ "$code" == 400 ]] && echo 1 || echo 0)"

# The ~ console's plan verb, as openttd-59's `plan <text>` prints it: the panel answers into the console.
pn="$(( $(date +%s) % 100000 + 1000 ))"
since="$(curl -s "$URL/api/status" | json "d['event_seq']")"
curl -s -X POST -H 'Content-Type: application/json' \
  -d "{\"command\":\"echo \\\"[prismatic-plan] $pn najdi nejproduktivnejsi les\\\"\",\"wait\":0.3}" "$URL/api/console" >/dev/null
answered=0
for _ in $(seq 1 40); do
  # The event feed keeps every console line (the log tail is only the last 150, and a building bot
  # scrolls an answer out of it within seconds).
  curl -s "$URL/api/events?since=$since&kinds=console.line&limit=5000" | grep -q "prismatic-plan\] $pn 1\. " && { answered=1; break; }
  sleep 1
done
check "a ~ console plan request ([prismatic-plan] $pn ...) is answered into the console with ranked candidates" "$answered"

out="$(curl -s -X POST -H 'Content-Type: application/json' -d '{"name":"openttd.view.console.print","arguments":{"text":"[mcp-view-check] one\ntwo","level":"rhai"}}' "$URL/api/view/tool")"
check "openttd.view.console.print writes each line into the owner's ~ console (2 lines, coloured rhai)" \
  "$([[ "$(json "d.get('ok') is True and d.get('lines') == 2" <<<"$out")" == True ]] && echo 1 || echo 0)"
plan="$(curl -s "$URL/api/plan?limit=3&params=%7B%22budget%22%3A300000%7D")"
check "rail candidates carry station sites (axis, flat rectangle, exit tile with its side) for an executor" \
  "$([[ "$(json "(lambda rail: len(rail) == 0 or all((c['stations']['from'] is None or c['stations']['from']['exit']['dir'] in ('NE','SE','SW','NW')) for c in rail))([c for c in d['portfolio']['chosen'] if c['mode'] in ('rail','freight_rail')])" <<<"$plan")" == True ]] && echo 1 || echo 0)"

# Plan before acting: AlgoGlyph action-plan turns actions into a DAG and cash-checked presses.
if [[ -n "$(curl -s "$URL/api/status" | json "'x'")" ]]; then
  out="$(curl -s -X POST -H 'Content-Type: application/json' -d '{"actions":[{"id":"borrow","kind":"borrow","amount":30000,"step":10000},{"id":"build","kind":"build","cost":1000,"after":["borrow"]}],"cash":10000,"loan":0,"max_loan":300000}' "$URL/api/actionplan")"
  check "an action plan is a DAG (borrow -> build) expanded into 4 presses with cash after each" \
    "$([[ "$(json "d.get('ok') is True and len(d['result']['steps']) == 4 and {'from': 'borrow', 'to': 'build'} in d['result']['graph']['edges']" <<<"$out")" == True ]] && echo 1 || echo 0)"
  code="$(curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' -d '{"actions":[{"id":"x","kind":"build","cost":999999999}],"cash":1000,"loan":0,"max_loan":0}' "$URL/api/actionplan")"
  check "a plan that would overdraw is refused before anything runs (http=$code)" "$([[ "$code" == 422 ]] && echo 1 || echo 0)"
  code="$(curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' -d '{}' "$URL/api/actionplan")"
  check "an action plan without actions is refused with 400 (http=$code)" "$([[ "$code" == 400 ]] && echo 1 || echo 0)"
  # What to build: AlgoGlyph transport-investment over the planner's candidates, within the budget.
  out="$(curl -s --max-time 240 "$URL/api/investment?params=%7B%22budget%22%3A300000%7D")"
  check "transport-investment ran for every cargo with candidates and chose a portfolio within the budget" \
    "$([[ "$(json "(lambda i: len(i['runs']) > 0 and all(r['ok'] for r in i['runs']) and len(i['portfolio']['chosen']) > 0 and i['portfolio']['investment_k'] <= i['portfolio']['budget_k'] and all(c['roi'] > 0 for c in i['portfolio']['chosen']))(d['investment'])" <<<"$out")" == True ]] && echo 1 || echo 0)"
  check "the kernel's portfolio is within 5% of the planner's own on the same game (two models, one answer)" \
    "$([[ "$(json "abs(d['investment']['portfolio']['total_score'] - d['planner_portfolio']['total_score']) <= 0.05 * d['planner_portfolio']['total_score']" <<<"$out")" == True ]] && echo 1 || echo 0)"
  code="$(curl -s -o /dev/null -w '%{http_code}' "$URL/api/investment?params=%5B1%5D")"
  check "investment params that are not an object are refused with 400 (http=$code)" "$([[ "$code" == 400 ]] && echo 1 || echo 0)"
fi

paths="$(curl -s "$URL/openapi.json" | json "' '.join(sorted(d['paths']))")"
want=(/api/actionplan /api/investment /api/intent /api/ask /api/news /api/news/close /api/plan /api/instances /api/graph /api/resources/map /api/resources/stations /api/view/tool /api/view/screenshot)
missing=()
for p in "${want[@]}"; do [[ " $paths " == *" $p "* ]] || missing+=("$p"); done
check "OpenAPI carries graph, map, stations and the view routes (missing: ${missing[*]:-none})" \
  "$([[ ${#missing[@]} -eq 0 ]] && echo 1 || echo 0)"

inst="$(curl -s "$URL/api/instances")"
self_port="${URL##*:}"
check "discovery lists this panel and its GUI client, both alive" \
  "$([[ "$(json "(lambda by: by.get('panel-$self_port', {}).get('alive') and by.get('client-$self_port', {}).get('alive'))({i['name']: i for i in d['instances']})" <<<"$inst")" == True ]] && echo 1 || echo 0)"
panels="$(json "' '.join(i['name'] for i in d['instances'] if i['kind'] == 'panel' and i['alive'])" <<<"$inst")"
reached=0 total=0
for name in $panels; do
  total=$((total + 1))
  out="$(curl -s -X POST -H 'Content-Type: application/json' \
    -d "{\"name\":\"$name\",\"method\":\"resources/read\",\"params\":{\"uri\":\"openttd://game/state\"}}" "$URL/api/instances/call")"
  [[ "$(json "'result' in d" <<<"$out")" == True ]] && reached=$((reached + 1))
done
check "every live panel in the cluster answers openttd://game/state through this panel ($reached/$total)" \
  "$([[ "$total" -gt 0 && "$reached" == "$total" ]] && echo 1 || echo 0)"
code="$(curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
  -d '{"name":"no-such-instance","method":"ping"}' "$URL/api/instances/call")"
check "a call to an unknown instance answers 404 (http=$code)" "$([[ "$code" == 404 ]] && echo 1 || echo 0)"

# The GUI client's tools are derived into routes: every tool of its live tools/list has one.
client_tools="$(curl -s -X POST -H 'Content-Type: application/json' -d "{\"name\":\"client-$self_port\",\"method\":\"tools/list\"}" "$URL/api/instances/call" | json "' '.join(t['name'] for t in d['result']['tools'])")"
api_paths="$(curl -s "$URL/openapi.json" | json "' '.join(sorted(d['paths']))")"
missing=()
total=0
for t in $client_tools; do
  total=$((total + 1))
  [[ " $api_paths " == *" /api/client/$t "* ]] || missing+=("$t")
done
check "every GUI client tool ($total) is a derived route /api/client/<tool> in OpenAPI (missing: ${missing[*]:-none})" \
  "$([[ "$total" -gt 0 && ${#missing[@]} -eq 0 ]] && echo 1 || echo 0)"
win="$(curl -s -X POST -H 'Content-Type: application/json' -d '{"widgets":true}' "$URL/api/client/openttd.ui.windows")"
check "the derived route answers openttd.ui.windows: windows with widgets" \
  "$([[ "$(json "len(d['windows']) > 0 and any(w.get('widgets') for w in d['windows'])" <<<"$win")" == True ]] && echo 1 || echo 0)"
cls="$(curl -s "$URL/api/ui/classes")"
check "window class names are derived from src/window_type.h (1 MainToolbar, 2 Statusbar)" \
  "$([[ "$(json "len(d) > 100 and d['1']['name'] == 'MainToolbar' and d['2']['name'] == 'Statusbar'" <<<"$cls")" == True ]] && echo 1 || echo 0)"
armed="$(curl -s -X POST "$URL/api/client/openttd.input.state" | json "d.get('armed')")"
out="$(curl -s -X POST -H 'Content-Type: application/json' -d '{"x":10,"y":10}' "$URL/api/client/openttd.input.pointer")"
if [[ "$armed" == True ]]; then
  check "input is armed by the owner: openttd.input.pointer moves the cursor" "$([[ "$(json "d.get('ok') is True" <<<"$out")" == True ]] && echo 1 || echo 0)"
else
  check "input is not armed: openttd.input.pointer is refused (the owner's switch holds)" "$([[ "$(json "d.get('ok') is not True" <<<"$out")" == True ]] && echo 1 || echo 0)"
fi
code="$(curl -s -o /dev/null -w '%{http_code}' "$URL/ui")"
check "the Interface page is served (http=$code)" "$([[ "$code" == 200 ]] && echo 1 || echo 0)"

code="$(curl -s -o /dev/null -w '%{http_code}' "$URL/world")"
check "the World page is served (http=$code)" "$([[ "$code" == 200 ]] && echo 1 || echo 0)"

printf '\nmcp-view-check: %d passed, %d failed\n' "$PASS" "$FAIL"
[[ "$FAIL" -eq 0 ]]
