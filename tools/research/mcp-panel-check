#!/usr/bin/env bash
# RESEARCH-ONLY check of the panel's derived surfaces against a running panel (issue I0032):
# the OpenAPI document derived from the live MCP catalogue, the generic REST routes it declares,
# Swagger UI, the REST event feed and the SSE event stream, and the same bus on ZeroMQ and in the
# DuckDB store (ADR 0033, I0080), with its declared event kinds and a planned bot's plan.portfolio
# and plan.bot_settings events on the bus and in the store (I0081).
#
# Usage: tools/research/mcp-panel-check [--panel http://127.0.0.1:8800] [--start-bot AI] [--track N]
#
# The planned bot: POST /api/bots/planned plans the bot as a panel's bot start does (mcp-plan's
# portfolio, then the settings) and publishes both decisions. Without --start-bot the bot is planned
# and not started, so the game is left as it was; --start-bot AI also starts AI with those settings,
# a new AI company in the game checked. The check fails when the planner failed (the route answers
# 502 and starts nothing) or handed over no settings. --track N prices N rail lines on the map first (AlgoGlyph;
# minutes per line), 0 by default.
# Exit status: 0 every check passed, 1 a check failed, 3 the panel is not reachable.
set -euo pipefail

PANEL="http://127.0.0.1:8800"
START_BOT="" TRACK=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --panel) PANEL="${2:?--panel needs a URL}"; shift 2 ;;
    --start-bot) START_BOT="${2:?--start-bot needs an AI name}"; shift 2 ;;
    --track) TRACK="${2:?--track needs a number}"; shift 2 ;;
    -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "mcp-panel-check: unknown argument $1 (usage: mcp-panel-check [--panel URL] [--start-bot AI] [--track N])" >&2; exit 2 ;;
  esac
done
for tool in python3 curl; do command -v "$tool" >/dev/null || { echo "mcp-panel-check: needs $tool" >&2; exit 3; }; done
curl -fs "$PANEL/api/status" >/dev/null || { echo "mcp-panel-check: no panel at $PANEL" >&2; exit 3; }

TMP="$(mktemp -d "${TMPDIR:-/tmp}/mcp-panel-check.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
PASS=0 FAIL=0
check() {
  if [[ "$2" == 1 ]]; then PASS=$((PASS + 1)); printf 'PASS  %s\n' "$1"; else FAIL=$((FAIL + 1)); printf 'FAIL  %s\n' "$1"; fi
}
py() { python3 -I -c "$1" "${@:2}"; }

curl -fs "$PANEL/openapi.json" > "$TMP/openapi.json"
curl -fs "$PANEL/api/catalogue" > "$TMP/catalogue.json"
out="$(py '
import json, sys
spec = json.load(open(sys.argv[1])); cat = json.load(open(sys.argv[2]))
tools = [t["name"] for t in cat["tools"]["result"]["tools"]]
res = [r["uri"].split("://", 1)[1] for r in cat["resources"]["result"]["resources"]]
paths = spec["paths"]
miss_t = [t for t in tools if f"/api/tools/{t}" not in paths]
miss_r = [r for r in res if f"/api/resources/{r}" not in paths]
schema_ok = all(paths[f"/api/tools/{t}"]["post"]["requestBody"]["content"]["application/json"]["schema"] for t in tools if f"/api/tools/{t}" in paths)
print(spec["openapi"], len(tools), len(res), len(miss_t), len(miss_r), int(schema_ok), len(paths))
' "$TMP/openapi.json" "$TMP/catalogue.json")"
read -r version ntools nres miss_t miss_r schema_ok npaths <<< "$out"
check "openapi.json is OpenAPI $version with $npaths paths" "$([[ "$version" == 3.1.0 ]] && echo 1 || echo 0)"
check "every MCP tool ($ntools) has a derived POST route" "$([[ "$ntools" -gt 0 && "$miss_t" == 0 ]] && echo 1 || echo 0)"
check "every MCP resource ($nres) has a derived GET route" "$([[ "$nres" -gt 0 && "$miss_r" == 0 ]] && echo 1 || echo 0)"
check "each derived tool route carries the tool's inputSchema as its body" "$([[ "$schema_ok" == 1 ]] && echo 1 || echo 0)"

state="$(curl -fs "$PANEL/api/resources/game/state")"
tick="$(py 'import json,sys; print(json.loads(sys.argv[1]).get("game_tick",""))' "$state")"
check "GET /api/resources/game/state answers live state (tick ${tick:-?})" "$([[ -n "$tick" ]] && echo 1 || echo 0)"
code="$(curl -s -o /dev/null -w '%{http_code}' "$PANEL/api/resources/no/such/resource")"
check "a resource this build does not have answers 404, not 200 with an error body (http=$code)" "$([[ "$code" == 404 ]] && echo 1 || echo 0)"
v="$(curl -fs -X POST -H 'Content-Type: application/json' -d '{"action":{"type":"game.set_pause","arguments":{"pause":true}}}' \
  "$PANEL/api/tools/openttd.decision.validate")"
valid="$(py 'import json,sys; d=json.loads(sys.argv[1]); print(d.get("valid", d.get("result", {}).get("valid", "")))' "$v")"
check "POST /api/tools/openttd.decision.validate validates without mutating (valid=$valid)" "$([[ "$valid" == True ]] && echo 1 || echo 0)"
bad="$(curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Origin: http://evil.example' -H 'Content-Type: application/json' -d '{}' "$PANEL/api/tools/openttd.decision.validate")"
check "a POST from a foreign Origin is refused (http=$bad)" "$([[ "$bad" == 403 ]] && echo 1 || echo 0)"

docs="$(curl -fs "$PANEL/docs")"; css="$(curl -s -o /dev/null -w '%{http_code}' "$PANEL/vendor/swagger-ui/swagger-ui-bundle.js")"
check "Swagger UI is served at /docs (bundle http=$css)" "$([[ "$docs" == *SwaggerUIBundle* && "$css" == 200 ]] && echo 1 || echo 0)"

seq0="$(curl -fs "$PANEL/api/status" | py 'import json,sys; print(json.load(sys.stdin)["event_seq"])')"
curl -fs -N --max-time 8 "$PANEL/api/events/stream?since=$seq0" > "$TMP/sse.txt" 2>/dev/null &
SSE=$!
sleep 1
curl -fs -X POST -H 'Content-Type: application/json' -d '{"command":"getdate"}' "$PANEL/api/console" >/dev/null
wait "$SSE" 2>/dev/null || true
nsse="$(grep -c '^event: ' "$TMP/sse.txt" || true)"
check "the SSE stream delivers events as they happen ($nsse in 7 s, incl. panel.console)" \
  "$([[ "$nsse" -gt 0 ]] && grep -q '^event: panel.console' "$TMP/sse.txt" && echo 1 || echo 0)"
rest="$(curl -fs "$PANEL/api/events?since=$seq0&kinds=panel.console")"
nrest="$(py 'import json,sys; d=json.loads(sys.argv[1]); print(sum(1 for e in d["events"] if e["kind"]=="panel.console"))' "$rest")"
check "GET /api/events?since=&kinds= filters the same feed ($nrest panel.console)" "$([[ "$nrest" -ge 1 ]] && echo 1 || echo 0)"
derived="$(curl -fs "$PANEL/api/events?since=0&kinds=game")"
ngame="$(py 'import json,sys; print(len(json.loads(sys.argv[1])["events"]))' "$derived")"
check "game events are derived from MCP reads (game.*: $ngame)" "$([[ "$ngame" -ge 1 ]] && echo 1 || echo 0)"

code="$(curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
  -d '{"command":"prismatic_mcp approve 999999","wait":0}' "$PANEL/api/console")"
check "an approval sent as a console line is refused (http=$code; approvals go through /api/approve)" \
  "$([[ "$code" == 403 ]] && echo 1 || echo 0)"
code="$(curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
  -d '{"command":"prismatic_mcp status","wait":0}' "$PANEL/api/console")"
check "an ordinary console line still runs (http=$code)" "$([[ "$code" == 200 ]] && echo 1 || echo 0)"

# A page per tool and resource: every item of the live catalogue answers its own page, titled by
# the catalogue (the server puts the name into <title>), and an unknown one is a 404.
curl -fs "$PANEL/api/catalogue" > "$TMP/catalogue.json"
py '
import json, sys, urllib.parse
c = json.load(open(sys.argv[1]))
for t in c["tools"]["result"]["tools"]: print("/tool/" + urllib.parse.quote(t["name"], safe="") + " " + t["name"])
for r in c["resources"]["result"]["resources"]: print("/resource/" + r["uri"].split("://", 1)[1] + " " + r["uri"])' "$TMP/catalogue.json" > "$TMP/pages.txt"
total=0; bad=""
while read -r path name; do
  [[ -n "$path" ]] || continue
  total=$((total + 1))
  code="$(curl -s -o "$TMP/page.html" -w '%{http_code}' "$PANEL$path")"
  grep -qF "<title>$name ·" "$TMP/page.html" && [[ "$code" == 200 ]] || bad="$bad $path($code)"
done < "$TMP/pages.txt"
check "every catalogue item has its own page titled by the catalogue ($total pages; failing:${bad:- none})" \
  "$([[ "$total" -gt 0 && -z "$bad" ]] && echo 1 || echo 0)"
code="$(curl -s -o /dev/null -w '%{http_code}' "$PANEL/tool/no.such.tool")"
check "a tool the catalogue lacks is a 404 page (http=$code)" "$([[ "$code" == 404 ]] && echo 1 || echo 0)"
code="$(curl -s -o /dev/null -w '%{http_code}' "$PANEL/tools")"
check "the catalogue page /tools is served (http=$code)" "$([[ "$code" == 200 ]] && echo 1 || echo 0)"

# The bus on ZeroMQ and the DuckDB store (ADR 0033, I0080): the endpoint is published, a SUB client
# receives what happens next, every event is in the store, and the query route only reads.
TAIL="${MCP_BUS_TAIL:-$(cd "$(dirname "$0")" && pwd)/mcp-rhai/target/release/mcp-bus-tail}"
bus="$(curl -fs "$PANEL/api/bus" || true)"
endpoint="$(py 'import json,sys; print(json.loads(sys.argv[1]).get("endpoint") or "")' "${bus:-{\}}" 2>/dev/null || true)"
check "GET /api/bus names the PUB endpoint (${endpoint:-none})" "$([[ "$endpoint" == tcp://127.0.0.1:* ]] && echo 1 || echo 0)"
if [[ -x "$TAIL" && -n "$endpoint" ]]; then
  "$TAIL" --endpoint "$endpoint" -n 1 --topic panel.console --timeout 10 > "$TMP/tail.jsonl" 2>/dev/null &
  TAILPID=$!
  sleep 1
  curl -fs -X POST -H 'Content-Type: application/json' -d '{"command":"getdate"}' "$PANEL/api/console" >/dev/null
  wait "$TAILPID" 2>/dev/null || true
  got="$(py '
import json, sys
lines = [json.loads(l) for l in open(sys.argv[1]) if l.strip()]
ok = [e for e in lines if e.get("schema") == "prismatic-bus/v1" and e.get("kind") == "panel.console" and "instance" in e and "seq" in e]
print(len(ok))' "$TMP/tail.jsonl" 2>/dev/null || echo 0)"
  check "a ZeroMQ SUB client (mcp-bus-tail) receives a panel.console envelope prismatic-bus/v1 ($got)" "$([[ "$got" -ge 1 ]] && echo 1 || echo 0)"
else
  check "a ZeroMQ SUB client receives an event (mcp-bus-tail not built at $TAIL)" 0
fi
q="$(curl -fs --get --data-urlencode 'sql=SELECT count(*) AS n FROM events' "$PANEL/api/db/query" || true)"
nev="$(py 'import json,sys; print(json.loads(sys.argv[1])["rows"][0][0])' "${q:-{\}}" 2>/dev/null || echo 0)"
check "GET /api/db/query: SELECT count(*) FROM events > 0 ($nev)" "$([[ "$nev" -gt 0 ]] && echo 1 || echo 0)"
code="$(curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
  -d '{"sql":"INSERT INTO events (kind) VALUES ('"'"'x'"'"')"}' "$PANEL/api/db/query")"
check "POST /api/db/query refuses INSERT (http=$code)" "$([[ "$code" == 400 ]] && echo 1 || echo 0)"
code="$(curl -s -o /dev/null -w '%{http_code}' --get --data-urlencode 'sql=SELECT 1; DROP TABLE events' "$PANEL/api/db/query")"
check "GET /api/db/query refuses a second statement (http=$code)" "$([[ "$code" == 400 ]] && echo 1 || echo 0)"

# The declared event kinds and the planned bot's decisions as data (I0081, ADR 0034 point 3).
kinds="$(py '
import json, sys
b = json.loads(sys.argv[1]); kinds = {k["kind"] for k in b.get("kinds") or []}
need = ["plan.portfolio", "plan.bot_settings", "plan.calibration", "plan.investment", "plan.action", "plan.intent", "plan.directive", "plan.kernel"]
seen = [t for t in b.get("topics_seen", {}) if t not in kinds]
print(len(kinds), len([k for k in need if k in kinds]), len(need), ",".join(seen) or "-")' "${bus:-{\}}" 2>/dev/null || echo "0 0 8 ?")"
read -r nkinds nplan nneed undeclared <<< "$kinds"
check "GET /api/bus lists the declared kinds ($nkinds, plan.*: $nplan of $nneed)" "$([[ "$nkinds" -gt 0 && "$nplan" == "$nneed" ]] && echo 1 || echo 0)"
check "every topic the bus has carried is a declared kind (undeclared: $undeclared)" "$([[ "$nkinds" -gt 0 && "$undeclared" == - ]] && echo 1 || echo 0)"
code="$(curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
  -d '{"kind":"plan.portfolio","data":{"decision":"x","version":{},"inputs":{},"choice":{}}}' "$PANEL/api/bus/publish")"
check "POST /api/bus/publish refuses a kind the panel publishes itself (http=$code)" "$([[ "$code" == 400 ]] && echo 1 || echo 0)"

ai="${START_BOT:-PrismaticAI}" start=false
t0="$(python3 -I -c 'import time; print(int(time.time() * 1000))')"
[[ -n "$START_BOT" ]] && start=true
seq0="$(curl -fs "$PANEL/api/status" | py 'import json,sys; print(json.load(sys.stdin)["event_seq"])')"
if [[ -x "$TAIL" && -n "$endpoint" ]]; then
  "$TAIL" --endpoint "$endpoint" -n 2 --topic plan.portfolio --topic plan.bot_settings --timeout 900 > "$TMP/plan.jsonl" 2>/dev/null &
  TAILPID=$!
  sleep 1
fi
code="$(curl -s -o "$TMP/planned.json" -w '%{http_code}' --max-time 900 -X POST -H 'Content-Type: application/json' \
  -d "{\"ai\":\"$ai\",\"start\":$start,\"track\":$TRACK}" "$PANEL/api/bots/planned")"
# A plan is a plan only with settings and without a planner error: a 200 with no settings, or a
# bot_settings that says unplanned, is a failed plan, whatever was started.
summary="$(py '
import json, sys
d = json.load(open(sys.argv[1])); b = d.get("bot_settings") or {}
why = d.get("error") or b.get("unplanned") or (d.get("portfolio") or {}).get("error") or "-"
print(len(d.get("settings") or ""), "started" if d.get("started") else "planned", b.get("rail_after"), why.replace(" ", "_")[:120])' \
  "$TMP/planned.json" 2>/dev/null || echo "0 - - unreadable_answer")"
read -r nset how rail_after unplanned <<< "$summary"
check "POST /api/bots/planned $how a planned $ai (http=$code; settings: $nset chars, rail_after=$rail_after, planner error: $unplanned)" \
  "$([[ "$code" == 200 && "$nset" -gt 0 && "$unplanned" == - && ( "$start" == false || "$how" == started ) ]] && echo 1 || echo 0)"
if [[ "$code" != 200 && -n "${TAILPID:-}" ]]; then
  # No plan was made, so no plan event is coming for the SUB client to wait for.
  kill "$TAILPID" 2>/dev/null || true
fi
rest="$(curl -fs "$PANEL/api/events?since=$seq0&kinds=plan" || echo '{"events": []}')"
got="$(py '
import json, sys
ev = json.loads(sys.argv[1])["events"]
ok = lambda e: all(f in e["data"] for f in ("decision", "version", "inputs", "choice")) and e["data"]["version"].get("revision")
print(" ".join(sorted({e["kind"] for e in ev if ok(e)})))' "$rest" 2>/dev/null || true)"
check "GET /api/events has plan.portfolio and plan.bot_settings with {decision, version, inputs, choice} ($got)" \
  "$([[ "$got" == *plan.bot_settings* && "$got" == *plan.portfolio* ]] && echo 1 || echo 0)"
if [[ -n "${TAILPID:-}" ]]; then
  wait "$TAILPID" 2>/dev/null || true
  zgot="$(py '
import json, sys
print(" ".join(sorted({json.loads(l)["kind"] for l in open(sys.argv[1]) if l.strip()})))' "$TMP/plan.jsonl" 2>/dev/null || true)"
  check "a ZeroMQ SUB client receives plan.portfolio and plan.bot_settings ($zgot)" \
    "$([[ "$zgot" == *plan.bot_settings* && "$zgot" == *plan.portfolio* ]] && echo 1 || echo 0)"
else
  check "a ZeroMQ SUB client receives the plan events (mcp-bus-tail not built at $TAIL)" 0
fi
sleep 2
q="$(curl -fs --get --data-urlencode "sql=SELECT kind, count(*) AS n FROM events WHERE kind IN ('plan.portfolio', 'plan.bot_settings') AND ts_ms >= $t0 AND json_extract_string(data, '$.version.revision') IS NOT NULL GROUP BY 1 ORDER BY 1" "$PANEL/api/db/query" || true)"
sgot="$(py 'import json,sys; print(" ".join(f"{k}={n}" for k, n in json.loads(sys.argv[1])["rows"]))' "${q:-{\}}" 2>/dev/null || true)"
check "the store's events hold this run's plan.portfolio and plan.bot_settings (${sgot:-none})" \
  "$([[ "$sgot" == *plan.bot_settings=* && "$sgot" == *plan.portfolio=* ]] && echo 1 || echo 0)"

printf '\nmcp-panel-check: %d passed, %d failed\n' "$PASS" "$FAIL"
[[ "$FAIL" -eq 0 ]]
