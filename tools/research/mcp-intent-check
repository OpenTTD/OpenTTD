#!/usr/bin/env bash
# RESEARCH-ONLY end-to-end check of the owner's four plan sentences, driven through the game's
# own console the way the owner types them into the tilde window.
#
# The chain under test is the whole one, not the HTTP endpoint alone:
#
#   ~ console:  plan <text>
#     -> ConPlan (src/console_cmds.cpp) prints "[prismatic-plan] <n> <text>" to console and log
#     -> the panel's log watcher (tools/research/mcp-panel/server.py, _answer_plan)
#     -> POST /api/intent {text}  (the resolver, tools/research/mcp-rhai)
#     -> echo lines "[prismatic-plan] <n> ..." back into the same console
#     -> for a build sentence, settings the bot takes through openttd.ai.set_setting,
#        which is approval-gated and therefore NOT exercised here.
#
# What it asserts, and why each assertion is here rather than a nicer one:
#
#   1. Each sentence comes back answered IN THE CONSOLE, not merely over HTTP. The owner's request
#      was about the tilde window, and the console path has two more moving parts than the
#      endpoint: the printed line and the watcher that reads it.
#   2. The reading line names the action, the ordering and the subjects it resolved, so a sentence
#      that was misunderstood is visible as a wrong reading rather than as plausible output.
#   3. A find sentence returns at least one candidate line; a build sentence returns settings whose
#      keys EXIST in PrismaticAI's info.nut (fr_from, fr_to, fr_cargo / rail_a, rail_b / air_a,
#      air_b). A plan naming a setting the bot does not have would look perfect and do nothing.
#   4. The vocabulary is derived, not hand-typed: /api/intent reports vocabulary_from inside
#      src/lang and a vocabulary_size in the thousands. This is the owner's standing requirement
#      ("vše genericky / derived") and the first thing a later change would quietly break.
#   5. NONSENSE DOES NOT ERROR. "xyzzy blah" falls back to the planner's own candidates and says so
#      in `how`. That is deliberate, and it is also the trap: without printing `how`, a sentence the
#      resolver did not understand looks exactly like one it did.
#
# It does not start a stack. Point it at a running panel (the panel starts the game); tools like
# mcp-e2e bring one up and print "control window:" with its port.
#
# Usage: tools/research/mcp-intent-check [--panel http://127.0.0.1:8800] [--wait 15]
# Exit: 0 every check passed, 1 a check failed, 2 usage, 3 a prerequisite is missing.
# Needs python3, curl, a running panel, and ai/PrismaticAI/info.nut from the bridge repository.
set -uo pipefail

PANEL="http://127.0.0.1:8800"
WAIT=15
INFO_NUT="${PRISMATIC_INFO_NUT:-$HOME/dev/openttd-prismatic-bridge/ai/PrismaticAI/info.nut}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --panel) PANEL="${2:-}"; shift 2 ;;
    --wait)  WAIT="${2:-}"; shift 2 ;;
    --info-nut) INFO_NUT="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,40p' "$0"; exit 2 ;;
    *) echo "mcp-intent-check: unknown argument $1" >&2; exit 2 ;;
  esac
done

command -v python3 >/dev/null || { echo "mcp-intent-check: python3 is missing" >&2; exit 3; }
command -v curl >/dev/null || { echo "mcp-intent-check: curl is missing" >&2; exit 3; }
[[ -r "$INFO_NUT" ]] || { echo "mcp-intent-check: no info.nut at $INFO_NUT (--info-nut)" >&2; exit 3; }
curl -fsS --max-time 5 "$PANEL/api/log" >/dev/null 2>&1 || \
  curl -fsS --max-time 5 "$PANEL/" >/dev/null 2>&1 || {
    echo "mcp-intent-check: no panel at $PANEL (start one, or pass --panel)" >&2; exit 3; }

# The settings the bot actually has, never listed here, so a renamed setting fails this check
# instead of silently producing a plan the bot cannot take.
#
# Preferred source is the RUNNING GAME: GET /api/bots -> companies[].settings[].name comes from
# openttd.ai.list, so it carries every declared setting including the ones info.nut builds in a
# loop (`name = "fr" + i + "_from"` declares fr2_* through fr8_*, which appear nowhere literally).
# The info.nut regex is only a fallback, and it CANNOT see those, so under the fallback an unknown
# key is a warning rather than a failure -- a check that fails on a setting the bot really has
# would be worse than one that misses a typo. openttd-80 caught this; the first version failed
# falsely the moment a build proposed a second line.
SETTINGS_SOURCE="info.nut (literal names only)"
mapfile -t BOT_SETTINGS < <(
  curl -fsS --max-time 10 "$PANEL/api/bots" 2>/dev/null |
  python3 -I -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for c in d.get("companies") or []:
    for s in c.get("settings") or []:
        if s.get("name"):
            print(s["name"])
' | sort -u
)
if [[ ${#BOT_SETTINGS[@]} -gt 0 ]]; then
  SETTINGS_SOURCE="the running game (/api/bots, openttd.ai.list)"
  STRICT_SETTINGS=1
else
  mapfile -t BOT_SETTINGS < <(grep -oE 'name = "[a-z_0-9]+"' "$INFO_NUT" | sed 's/.*"\(.*\)"/\1/' | sort -u)
  STRICT_SETTINGS=0
fi
[[ ${#BOT_SETTINGS[@]} -gt 0 ]] || { echo "mcp-intent-check: no settings from the game or $INFO_NUT" >&2; exit 3; }

fails=0
note() { printf '%s\n' "$*"; }
fail() { printf 'FAIL %s\n' "$*"; fails=$((fails + 1)); }

# console <text>: send one console line as the operator and print what it produced.
console() {
  python3 -I -c 'import json,sys; print(json.dumps({"command": sys.argv[1], "wait": float(sys.argv[2])}))' \
    "plan $1" "$WAIT" |
  curl -fsS --max-time "$((WAIT + 20))" -X POST "$PANEL/api/console" \
       -H 'content-type: application/json' --data-binary @- |
  python3 -I -c '
import json, sys
d = json.load(sys.stdin)
out = d.get("output") or d.get("lines") or ""
print("\n".join(out) if isinstance(out, list) else str(out))
'
}

# intent <text>: the resolver answer as JSON, for the fields the console line does not carry.
intent() {
  python3 -I -c 'import json,sys; print(json.dumps({"text": sys.argv[1]}))' "$1" |
  curl -fsS --max-time 60 -X POST "$PANEL/api/intent" \
       -H 'content-type: application/json' --data-binary @-
}

note "panel      $PANEL"
note "bot settings from $SETTINGS_SOURCE: ${BOT_SETTINGS[*]}"

# --- 4. the vocabulary is derived --------------------------------------------------------------
vocab="$(intent "najdi nejproduktivnejsi les" 2>/dev/null)"
python3 -I - "$vocab" <<'PY' || fails=$((fails + 1))
import json, sys
d = json.loads(sys.argv[1] or "{}")
src, size = str(d.get("vocabulary_from", "")), int(d.get("vocabulary_size") or 0)
ok = "/src/lang" in src.replace("\\", "/") and size >= 100
print(f"{'ok  ' if ok else 'FAIL'} vocabulary derived: {size} words from {src or '(nothing)'}")
sys.exit(0 if ok else 1)
PY

# --- 1-3. the four sentences, through the console ----------------------------------------------
# text | expected action | expected ordering | at least one subject name that must be resolved
CASES=(
  "najdi nejproduktivnejsi les|find|most_productive|Forest"
  "najdi nejblizsi les + pila|find|nearest|Forest,Sawmill"
  "vystav trat mezi nejproduktivnejsi les + pila|build|most_productive|Forest,Sawmill"
  "vybuduj nejlukrativnejsi trat|build|most_profitable|"
)

for case in "${CASES[@]}"; do
  IFS='|' read -r text want_action want_order want_subjects <<<"$case"
  note ""
  note "--- plan $text"
  out="$(console "$text")"
  if ! grep -qF "[prismatic-plan]" <<<"$out"; then
    fail "$text: the console printed no [prismatic-plan] line (is the panel's watcher running?)"
    continue
  fi
  if [[ $(grep -cF "[prismatic-plan]" <<<"$out") -lt 2 ]]; then
    fail "$text: the request was printed but never answered in the console"
    continue
  fi
  reading="$(grep -F "[prismatic-plan]" <<<"$out" | sed -n '2p')"
  note "    reading: ${reading#*] }"

  json="$(intent "$text" 2>/dev/null)"
  python3 -I - "$json" "$want_action" "$want_order" "$want_subjects" "${BOT_SETTINGS[*]}" "$STRICT_SETTINGS" <<'PY' || fails=$((fails + 1))
import json, sys
d = json.loads(sys.argv[1] or "{}")
want_action, want_order, want_subjects = sys.argv[2], sys.argv[3], sys.argv[4]
settings, strict = set(sys.argv[5].split()), sys.argv[6] == "1"
i, a = d.get("intent") or {}, d.get("answer") or {}
bad = []
if i.get("action") != want_action:
    bad.append(f"action {i.get('action')!r} not {want_action!r}")
if i.get("ordering") != want_order:
    bad.append(f"ordering {i.get('ordering')!r} not {want_order!r}")
got = {s.get("name") for s in (i.get("subjects") or [])}
for name in filter(None, want_subjects.split(",")):
    if name not in got:
        bad.append(f"subject {name!r} not resolved (got {sorted(got)})")
if not (a.get("candidates") or []):
    bad.append("no candidates")
if not a.get("how"):
    bad.append("no `how` line — a misread sentence would look like a good one")
if want_action == "build":
    keys = set((a.get("build") or {}).get("settings") or {})
    if not keys:
        bad.append("a build sentence returned no settings")
    unknown = keys - settings
    if unknown and strict:
        bad.append(f"settings the bot does not have: {sorted(unknown)}")
    elif unknown:
        print(f"    note: {sorted(unknown)} not seen in info.nut's literal names; it declares "
              f"some in a loop, so this is not failed while no bot is running")
    if any(v is None for v in ((a.get("build") or {}).get("settings") or {}).values()):
        bad.append("a setting is null — the bot would take a plan that names nothing")
    print(f"    build: {json.dumps((a.get('build') or {}).get('settings'), sort_keys=True)}")
print(("FAIL " + "; ".join(bad)) if bad else f"    ok  {len(a.get('candidates') or [])} candidate(s), solver {a.get('solver')}")
sys.exit(1 if bad else 0)
PY
done

# --- 5. nonsense falls back and says so ---------------------------------------------------------
note ""
note "--- a sentence that names nothing"
json="$(intent "xyzzy blah" 2>/dev/null)"
python3 -I - "$json" <<'PY' || fails=$((fails + 1))
import json, sys
d = json.loads(sys.argv[1] or "{}")
a, i = d.get("answer") or {}, d.get("intent") or {}
how = a.get("how") or ""
ok = bool(how) and not (i.get("subjects") or [])
print(f"{'    ok  ' if ok else 'FAIL'} nonsense does not error; it falls back and `how` says so: {how!r}")
sys.exit(0 if ok else 1)
PY

note ""
if [[ $fails -eq 0 ]]; then
  note "mcp-intent-check: every check passed"
  exit 0
fi
note "mcp-intent-check: $fails check(s) failed"
exit 1
