#!/usr/bin/env bash
# RESEARCH-ONLY: a duel in one game. Two companies on the same map compete for the same towns and
# industries: company A is the owner's bot started from the planner's portfolio (the panel does it),
# company B another AI: by default the same bot started without a plan, or any installed AI named with
# --opponent (e.g. AdmiralAI or SimpleAI from BaNaNaS, downloaded with the console's content commands). Every game month both are read from the console's
# `companies` command; after N months the one with the higher company value wins. The record goes to
# research/results/duel-<time>-seed<N>.{json,md} with both bots' logs.
#
# Usage: tools/research/mcp-duel [--months 24] [--seed N] [--label text] [--opponent AI]
#                               [--bot-settings k=v,...]
# Exit: 0 the duel completed (whoever won), 1 the stack did not come up, 2 bad arguments.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
MONTHS=24 SEED="$RANDOM" LABEL="" OPPONENT="PrismaticAI" BOT_SETTINGS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --months) MONTHS="${2:?}"; shift 2 ;;
    --seed) SEED="${2:?}"; shift 2 ;;
    --label) LABEL="${2:?}"; shift 2 ;;
    --opponent) OPPONENT="${2:?}"; shift 2 ;;
    --bot-settings) BOT_SETTINGS="${2:?}"; shift 2 ;;
    -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "usage: mcp-duel [--months N] [--seed N] [--label text] [--opponent AI] [--bot-settings k=v,...]" >&2; exit 2 ;;
  esac
done
free() { python3 -I -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'; }
PANEL="$(free)"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/mcp-duel.XXXXXX")"
PID=""
cleanup() { [[ -n "$PID" ]] && kill -TERM "$PID" 2>/dev/null; wait 2>/dev/null || true; }
trap cleanup EXIT INT TERM

# Extra settings for the planned bot only (company A), on top of what the panel derives from the plan,
# e.g. own_lines=8: an A/B of a bot feature without a code change. The panel reads them at bot start.
export PRISMATIC_BOT_SETTINGS="$BOT_SETTINGS"
echo "==> duel on :$PANEL, seed $SEED, $MONTHS months${BOT_SETTINGS:+, bot settings $BOT_SETTINGS}"
"$ROOT_DIR/tools/research/mcp-e2e" --no-gui --no-browser --seed "$SEED" --panel-port "$PANEL" \
  --mcp-port "$(free)" --game-port "$(free)" > "$TMP/stack.log" 2>&1 &
PID=$!
for ((i = 0; i < 240; i++)); do
  curl -s "http://127.0.0.1:$PANEL/api/status" 2>/dev/null | grep -q '"ai_started": true' && break
  sleep 2
done
curl -s "http://127.0.0.1:$PANEL/api/status" | grep -q '"ai_started": true' || { echo "mcp-duel: the stack did not come up ($TMP)" >&2; exit 1; }

# Company B: the opponent AI with its own defaults (start_ai with no settings starts a new AI
# company). An AI the game does not have is refused here, before any month is played.
out="$(curl -s -X POST -H 'Content-Type: application/json' -d "{\"command\":\"start_ai $OPPONENT\",\"wait\":2.0}" \
  "http://127.0.0.1:$PANEL/api/console")"
# The game's own refusal (console_cmds.cpp ConStartAI); the bot's log lines may say "failed" too.
if grep -q "Failed to load the specified AI" <<<"$out"; then
  echo "mcp-duel: the game has no AI named $OPPONENT: $out" >&2; exit 2
fi

python3 -I - "$PANEL" "$MONTHS" "$SEED" "$LABEL" "$ROOT_DIR" "$OPPONENT" "$BOT_SETTINGS" <<'PY'
import json, os, re, sys, time, urllib.request
port, months, seed, label, root, opponent, bot_settings = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6], sys.argv[7]
ROW = re.compile(r"#:(\d+)\(.*?\)\s+Company Name: '([^']*)'\s+Year Founded: (\d+)\s+Money: (-?\d+)\s+Loan: (\d+)\s+Value: (-?\d+)\s+\(T:(\d+), R:(\d+), P:(\d+), S:(\d+)\)")
import urllib.error
def patient(open_):
    # A busy game can make one read fail (a 502 from the panel, a timeout). Every call here only reads
    # (state, events, the console's `companies`), so it is tried again; one failed read lost a whole
    # 36-month run at month 15 (2026-11-17).
    for attempt in range(6):
        try:
            with open_() as r:
                return json.loads(r.read())
        except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError) as e:
            if isinstance(e, urllib.error.HTTPError) and e.code < 500 or attempt == 5:
                raise
            print(f"mcp-duel: a read failed ({e}); trying again", file=sys.stderr)
            time.sleep(3)
def post(path, body):
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", data=json.dumps(body).encode(), headers={"Content-Type": "application/json"}, method="POST")
    return patient(lambda: urllib.request.urlopen(req, timeout=30))
def get(path):
    return patient(lambda: urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=30))
def companies():
    out = post("/api/console", {"command": "companies", "wait": 1.0}).get("output", [])
    text = " ".join(l if isinstance(l, str) else str(l) for l in out)
    return {int(m[0]): {"name": m[1], "money": int(m[3]), "loan": int(m[4]), "value": int(m[5]),
                         "trains": int(m[6]), "road": int(m[7]), "planes": int(m[8])} for m in ROW.findall(text)}
def months_seen():
    """The game month as a running count, from the game's own date (year * 12 + month). Counting
    game.month events undercounted: the panel's event buffer is capped and drops the oldest, so a
    120-month duel's month 72 was dated 29 months after its month 60 (2026-11-16)."""
    date = str(get("/api/resources/game/state").get("game_date", ""))
    m = re.match(r"(\d{4})-(\d{2})", date)
    return int(m[1]) * 12 + int(m[2]) - 1 if m else 0
plan = [e["text"] for e in get("/api/status")["events"] if e["kind"] == "ai" and e["text"].startswith("planner")]
start = months_seen(); seen = start; series = []
while seen - start < months:
    time.sleep(20)
    n = months_seen()
    if n > seen:
        seen = n
        snap = companies()
        date = get("/api/resources/game/state").get("game_date")
        series.append({"month": n - start, "date": date, "companies": snap})
        print(f"month {n - start:>2} {date}: " + "; ".join(f"#{k} {v['name']} value {v['value']} (T{v['trains']} R{v['road']} P{v['planes']})" for k, v in sorted(snap.items())), flush=True)
final = series[-1]["companies"] if series else {}
# Company #1 is the planned bot (started by the panel first), #2 the unplanned one.
a, b = final.get(1, {}), final.get(2, {})
b_name = "unplanned" if opponent == "PrismaticAI" else opponent
winner = "A (planned)" if a.get("value", 0) > b.get("value", 0) else (f"B ({b_name})" if b.get("value", 0) > a.get("value", 0) else "tie")
logs = {}
for e in get("/api/events?since=0&kinds=ai.log&limit=5000").get("events", []):
    logs.setdefault(str(e["data"]["company"]), []).append(e["data"]["text"])
stamp = time.strftime("%Y%m%dT%H%M%S")
os.makedirs(f"{root}/research/results", exist_ok=True)
base = f"{root}/research/results/duel-{stamp}-seed{seed}"
json.dump({"experiment": f"duel in one game: planned bot (A, company 1) vs {b_name} (B, company 2)", "label": label, "opponent": opponent, "bot_settings": bot_settings,
           "seed": int(seed), "months": months, "plan": plan, "final": final, "winner": winner, "series": series, "bot_log": logs},
          open(base + ".json", "w"), indent=2)
rows = "\n".join(f"| {s['month']} | {s['date']} | {s['companies'].get(1, {}).get('value', '')} | {s['companies'].get(2, {}).get('value', '')} |" for s in series)
open(base + ".md", "w").write(f"""# Duel in one game: planned bot vs {b_name} (seed {seed}, {months} months)

Generated by `tools/research/mcp-duel`{(' (' + label + ')') if label else ''}. One game, one map: company 1 is PrismaticAI started from
the planner's portfolio (by the panel){(' with extra settings ' + bot_settings) if bot_settings else ''}, company 2 {('the same AI started without a plan' if opponent == 'PrismaticAI' else opponent + ' with its own defaults')} right after it.
Both compete for the same towns and industries. Values come from the console's `companies` command.

{chr(10).join('- ' + p for p in plan) or '- no planner line recorded'}

**Winner: {winner}.** Final company value: A {a.get('value')} vs B {b.get('value')}.

| Month | Date | A (planned) value | B ({b_name}) value |
|---|---|---|---|
{rows}
""")
print(f"\nmcp-duel: winner {winner}: A {a.get('value')} vs B {b.get('value')}; {base}.md")
PY

# The README scoreboard is derived from research/results: regenerate it after every result, so the
# landing page never lags a duel (tools/research/readme-scoreboard; commit and push stay the owner's).
# Appended after the heredoc on purpose: bash reads a running script by offset, so a duel already
# running picks this up instead of being shifted.
if python3 "$ROOT_DIR/tools/research/readme-scoreboard"; then
  echo "mcp-duel: README scoreboard regenerated"
else
  echo "mcp-duel: README scoreboard NOT regenerated" >&2
fi
