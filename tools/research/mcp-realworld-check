#!/usr/bin/env node
// RESEARCH-ONLY. The real-world places checked in a real browser (research/real-world-scenario.md):
// /realworld lists every place snapshot with its query and links each one; /realworld/brno draws
// its map card (an echarts instance with a non-zero width and series that carry data), shows the
// place, map and contract tiles with the contract valid, shows every evidence class its entities
// use (read from /api/realworld/scenario) as a badge, and maximize puts `max` in the address and Escape restores it; an unknown place answers
// 404; the console stays free of errors. Drives the installed Chrome through playwright-core (a dev
// dependency of tools/research/mcp-panel: npm ci there), so nothing downloads a browser.
//
// e2e-covers: panel /realworld
//
// Usage: tools/research/mcp-realworld-check http://127.0.0.1:<panel-port>   (exit 0 PASS, 1 FAIL)
import { createRequire } from 'node:module';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

const here = path.dirname(fileURLToPath(import.meta.url));
const require = createRequire(path.join(here, 'mcp-panel', 'package.json'));
const { chromium } = require('playwright-core');
const CHROME = process.env.CHROME || '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome';

const base = (process.argv[2] || '').replace(/\/$/, '');
if (!base) { console.error('usage: mcp-realworld-check <panel-url>'); process.exit(2); }
const checks = [];
const check = (name, ok, detail = '') => { checks.push(ok); console.log(`${ok ? 'PASS' : 'FAIL'} ${name}${detail ? ` (${detail})` : ''}`); };

const browser = await chromium.launch({ executablePath: CHROME, headless: true, args: ['--enable-unsafe-swiftshader'] });
try {
  const page = await browser.newPage({ viewport: { width: 1600, height: 1400 } });
  const errors = [];
  page.on('console', (m) => { if (m.type() === 'error' && !/404/.test(m.text())) errors.push(m.text()); });
  page.on('pageerror', (e) => errors.push(e.message));

  await page.goto(`${base}/realworld`);
  const listed = await page.waitForFunction(() => document.querySelectorAll('#page a[href^="/realworld/"]').length > 0, null, { timeout: 30000 })
    .then(() => page.evaluate(() => [...document.querySelectorAll('#page a[href^="/realworld/"]')].map((a) => a.getAttribute('href')))).catch(() => []);
  check('/realworld lists the place snapshots, each a link', listed.includes('/realworld/brno'), listed.join(' '));

  await page.goto(`${base}/realworld/brno`);
  const drawn = await page.waitForFunction(() => {
    const box = document.getElementById('rw-map');
    const c = box && box.offsetWidth > 0 && window.echarts && window.echarts.getInstanceByDom(box);
    const o = c && c.getOption();
    return o && o.series.some((s) => (s.data || []).length > 0);
  }, null, { timeout: 45000 }).then(() => true).catch(() => false);
  check('/realworld/brno draws its map with data within 45 s', drawn);
  const facts = await page.evaluate(() => ({
    title: document.title,
    text: document.getElementById('page').innerText,
  }));
  check('the page title comes from the snapshot', /Brno/.test(facts.title), facts.title);
  check('the contract tile says valid', /Contract\s+valid/i.test(facts.text));
  // The classes the scenario's entities use, read from the API (source features are OBSERVED; game
  // entities are DERIVED, INFERRED or HYPOTHETICAL), and each must show on the page as a badge.
  const used = await page.evaluate(async () => [...new Set(((await (await fetch('/api/realworld/scenario?name=brno')).json()).scenario.entities || []).map((e) => e.evidence))].sort());
  const missingClasses = used.filter((c) => !facts.text.includes(c));
  check('every evidence class the entities use appears as a badge', used.length > 0 && missingClasses.length === 0, `${used.join(' ')}${missingClasses.length ? '; missing ' + missingClasses.join(' ') : ''}`);
  await page.click('#rw-map-card button:has-text("Maximize")');
  const maxed = await page.evaluate(() => [document.getElementById('rw-map-card').classList.contains('fixed'), location.hash + location.search]);
  check('maximize fills the viewport and puts max in the address', maxed[0] && maxed[1].includes('max=rw-map'), maxed[1]);
  await page.keyboard.press('Escape');
  const restored = await page.evaluate(() => [document.getElementById('rw-map-card').classList.contains('fixed'), location.hash + location.search]);
  check('Escape restores it and clears max', !restored[0] && !restored[1].includes('max='), restored[1]);

  const missing = await page.goto(`${base}/realworld/no-such-place`);
  check('an unknown place answers 404', missing && missing.status() === 404, String(missing && missing.status()));
  check('the console has no errors', errors.length === 0, errors.slice(0, 3).join(' | '));
} finally {
  await browser.close();
}
process.exit(checks.every(Boolean) ? 0 : 1);
